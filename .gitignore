# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# pixi materialized environments (regenerate from pixi.lock)
.pixi/
**/.pixi/

# tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# profiling / large artifacts
*.nsys-rep
*.ncu-rep
*.sqlite
*.tar.gz
*.so

# profiler capture outputs live in <target>/profiles/ (siblings of artifacts/); keep the dir, drop captures
benchmarks/**/profiles/*
!benchmarks/**/profiles/.gitkeep

# generated benchmark/profiling artifacts
# Generated benchmark data + figures are NOT tracked (kernel-library convention:
# ship the bench scripts, regenerate results, keep curated tables in docs). This
# keeps the repo lean for consumers that vendor it as a submodule.
benchmarks/**/artifacts/**
!benchmarks/**/artifacts/**/
!benchmarks/**/artifacts/**/.gitkeep
benchmarks/**/plots/**
!benchmarks/**/plots/**/
!benchmarks/**/plots/**/.gitkeep
!benchmarks/**/artifacts/**/*.png
!benchmarks/**/artifacts/**/*.pdf
!benchmarks/**/artifacts/**/*.txt
!benchmarks/**/artifacts/**/*.json
!benchmarks/**/artifacts/**/*.md
benchmark/logs/
benchmark/
config/
src/**/benchmark/
*.out

# local scratch/vendor workspaces kept outside package boundaries
_ct_tmp/
_trans_tmp/
experiments/
scratchpad_ncu/
third_party/ct_cutlass_workbench/*.out
third_party/ct_cutlass_workbench/*.so

# editor
.vscode/

# hydra run outputs (transient)
outputs/
/results/

# secrets / local agent worktrees / scratch (added by checkpoint)
notion_token
_fold_t.py
.claude/

# job logs (SLURM .out etc.) — sibling of artifacts/
benchmarks/**/logs/

# --- Curated benchmark results — TRACKED (this is the policy, not the exception) ---
# CSV (the numbers = source of truth) is tracked for BOTH kernel and module benches.
# Plots (PNG/PDF) are tracked for MODULE benches only; kernel benches are CSV-only.
# Layout: benchmarks/results/{kernels,modules}/<name>/<gpu>.csv  (+ .png under modules/).
# OVERWRITE the same path each run so git stores diffs, not new blobs. Raw logs/dumps
# (*.out, *.so, *.ncu-rep, ...) never track here — blocked by the global rules above.
benchmarks/results/**
!benchmarks/results/**/
!benchmarks/results/**/*.csv
!benchmarks/results/**/*.md
!benchmarks/results/**/*.json
# plots: module benches only (kernel benches commit CSV, no PNG)
!benchmarks/results/modules/**/*.png
!benchmarks/results/modules/**/*.pdf
