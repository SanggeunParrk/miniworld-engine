# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# anchored: setuptools' build artefacts live at the repo root only, and an unanchored "build/"
# also swallows src/miniworld_engine/build/ -- a real package, whose absence from git shows up as
# an ImportError in the cache builder rather than as a missing file.
/build/
dist/

# pixi materialized environments (regenerate from pixi.lock)
.pixi/
**/.pixi/

# tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# profiling / large artifacts
*.nsys-rep
*.ncu-rep
*.sqlite
*.tar.gz
*.so

# profiler capture outputs live in <target>/profiles/ (siblings of artifacts/); keep the dir, drop captures
benchmarks/**/profiles/*
!benchmarks/**/profiles/.gitkeep

# --- benchmark layout: per target, benchmarks/{modules,kernels}/<target>/ holds ---
#   artifacts/  raw bench output (CSVs, autotune summaries)  -> SCRATCH, ignored
#   plots/      raw plot_csv.py SVG output                    -> SCRATCH, ignored
#   results/    CURATED results kept in git                   -> TRACKED
#               results/<gpu>/tables/*.csv  +  results/<gpu>/plots/*.svg (modules)
# Scratch is scoped to the target level (benchmarks/*/*/{artifacts,plots}); the deeper
# results/<gpu>/plots/ is NOT matched by that (it is 2 levels below), so curated results
# track by default. Raw dumps (*.out/*.ncu-rep/*.so) stay ignored everywhere via the global
# rules. Policy: kernels commit CSV only — any .svg under kernels/*/results/ is ignored.
benchmarks/*/*/artifacts/**
!benchmarks/*/*/artifacts/**/
!benchmarks/*/*/artifacts/**/.gitkeep
benchmarks/*/*/plots/**
!benchmarks/*/*/plots/**/
!benchmarks/*/*/plots/**/.gitkeep
benchmarks/kernels/*/results/**/*.svg
benchmarks/kernels/*/results/**/*.pdf
benchmark/logs/
benchmark/
config/
src/**/benchmark/
*.out

# local scratch/vendor workspaces kept outside package boundaries
_ct_tmp/
_trans_tmp/
experiments/
# dev/ holds development scratch, research probes, ncu harnesses (never shipped: the wheel is
# src/ only). dev/scratchpad_ncu/ is local scratch (ncu dumps, kernel .cu backups, optimizer
# prompt logs) — kept ignored as it was under the old scratchpad_ncu/ path; a handful of files
# there stay tracked (they were committed before the move). dev/research and dev/bench are tracked.
dev/scratchpad_ncu/
third_party/ct_cutlass_workbench/*.out
third_party/ct_cutlass_workbench/*.so
# vendored CUTLASS checkout (166M) — build dependency, never tracked
third_party/ct_cutlass_workbench/cutlass/

# editor
.vscode/

# hydra run outputs (transient)
outputs/
/results/

# secrets / local agent worktrees / scratch (added by checkpoint)
notion_token
_fold_t.py
.claude/

# job logs (SLURM .out etc.) — sibling of artifacts/
benchmarks/**/logs/

# --- .bench: audit scratch, never tracked -----------------------------------------------------
# One-off probes, per-run logs, result CSVs and sbatch wrappers. The audit tools worth keeping
# live in tools/kernel-audit/ instead, because docs/kernels/tiling-audit.md cites them by path and
# the audit it records has to stay reproducible from a clean checkout.
.bench/
