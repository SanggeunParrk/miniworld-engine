# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
dist/

# pixi environment (regenerated from pixi.lock)
.pixi/
**/.pixi/

# tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# built kernels and profiler dumps (the prebuilder writes to ~/.cache/miniworld_engine_jit; a release bundle is added by the wheel build)
*.so
*.cubin
src/miniworld_engine/_prebuilt/
*.nsys-rep
*.ncu-rep
*.sqlite
*.out

# measurement records and plans live outside the repo (scratch); never commit them here
/records/
/plans/

# local
.privates/
.vscode/
.claude/*
!.claude/CLAUDE.md
!.claude/agents/

# the Anthropic release is cloned locally (third_party/anthropic/UPSTREAM.json pins it); never tracked
third_party/anthropic/upstream/
