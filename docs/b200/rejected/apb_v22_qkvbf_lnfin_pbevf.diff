+// ln_fin (v22, 2026-11-17): ln_bwd_pk + finalize_red_k in ONE launch (the last two launches of the training backward's chain). The first
+// nlb blocks are LayerNorm-backward blocks: each 128-thread quarter of a 512-thread block is one of ln_bwd's 4-row blocks (row group gi,
+// the same rows, statements and column sums into acc row gi, so the same bits); a quarter that has written its two partial rows counts
+// itself on g_lnfin[0] (fence, then one atomic). The finalize blocks follow in finalize_red's order; only the row-column blocks of the
+// LayerNorm columns [0, 2 D) wait (thread 0 spins until all ng groups have counted, acquire), and read acc through L2 (ld.cg). The last
+// waiter resets both counters (g_lnfin[1] counts the waiters), so every launch starts at zero. Deterministic: every sum keeps its order.
+__device__ unsigned g_lnfin[2];
+template <int NH, int V>
+__global__ void __launch_bounds__(FR_T) ln_fin_k(const bf* __restrict__ DXA, const bf* __restrict__ X, const float2* __restrict__ ST,
+    const float* __restrict__ LW, const bf* __restrict__ DY, bf* __restrict__ DX, int M, int nlb,
+    const float* __restrict__ DWP, const float* __restrict__ DWO, float* ACC,
+    int width, int rows_a, int rows_b, const bf* __restrict__ WB, const float* __restrict__ LPW, float* __restrict__ OQ, float* __restrict__ OKe,
+    float* __restrict__ OV, float* __restrict__ OG, float* __restrict__ OO, float* __restrict__ OLW, float* __restrict__ OLB,
+    float* __restrict__ OBQ, float* __restrict__ OWB, float* __restrict__ OLPW, Geo G, int ncopy, int nra) {
+  APB_PDL_ENTRY();
+  constexpr int D = 128 * V, HG = FR_G / 2;
+  constexpr int RED_N = (4 * RW * D > NH * HG * 8) ? 4 * RW * D : NH * HG * 8;
+  __shared__ __align__(16) float red[RED_N];
+  __shared__ float fin[NH * 8];
+  const int tid = threadIdx.x;
+  const int ng = (M + RW - 1) / RW;
+  if ((int)blockIdx.x < nlb) {                                              // ---- LayerNorm backward: 4 row groups a block
+    const int q4 = tid >> 7, tq = tid & 127, wq = tq >> 5, lane = tid & 31;
+    const int gi = (int)blockIdx.x * 4 + q4;
+    if (gi >= ng) return;                                                   // whole quarters only: the named barriers stay matched
+    float* rq = red + q4 * RW * D;
+    const long r = (long)gi * RW + wq;
+    float4 aw[V] = {}, ab[V] = {};
+    if (r < M) {
+      float4 dxa[V], xh[V], w[V], g[V], dy[V];
+      ldv<V>(DXA + r * D, dxa); ldv<V>(X + r * D, xh); ldv<V>(LW, w); ldv<V>(DY + r * D, dy);
+      const float2 st = ST[r];
+#pragma unroll
+      for (int k = 0; k < V; ++k) {
+        xh[k] = make_float4((xh[k].x - st.x) * st.y, (xh[k].y - st.x) * st.y, (xh[k].z - st.x) * st.y, (xh[k].w - st.x) * st.y);
+        g[k] = mul4(dxa[k], w[k]);
+        aw[k] = mul4(dxa[k], xh[k]);
+        ab[k] = dxa[k];
+      }
+      const float m1 = warp_sum(sumv<V>(g)) * (1.f / D), m2 = warp_sum(dotv<V>(g, xh)) * (1.f / D);
+#pragma unroll
+      for (int k = 0; k < V; ++k)
+        dy[k] = make_float4(dy[k].x + st.y * (g[k].x - m1 - xh[k].x * m2), dy[k].y + st.y * (g[k].y - m1 - xh[k].y * m2),
+                            dy[k].z + st.y * (g[k].z - m1 - xh[k].z * m2), dy[k].w + st.y * (g[k].w - m1 - xh[k].w * m2));
+      stv<V>(DX + r * D, dy);
+    }
+    // colsum_add over the quarter (ln_bwd's block): the same order (warps 0..3 of the group)
+    auto qsum = [&](const float4 (&v)[V], float* out) {
+      const int c = 4 * V * lane;
+#pragma unroll
+      for (int k = 0; k < V; ++k) *reinterpret_cast<float4*>(rq + wq * D + c + 4 * k) = v[k];
+      asm volatile("bar.sync %0, 128;" ::"r"(1 + q4) : "memory");
+      for (int j = tq; j < D; j += 128) {
+        float t = 0.f;
+#pragma unroll
+        for (int w = 0; w < RW; ++w) t += rq[w * D + j];
+        out[(long)gi * width + j] = t;
+      }
+      asm volatile("bar.sync %0, 128;" ::"r"(1 + q4) : "memory");
+    };
+    qsum(aw, ACC);
+    qsum(ab, ACC + D);
+    __threadfence();
+    asm volatile("bar.sync %0, 128;" ::"r"(1 + q4) : "memory");
+    if (tq == 0) atomicAdd(&g_lnfin[0], 1u);
+    return;
+  }
+  const int W = G.nh * G.dhp, nwf = G.dp / 8;
+  int bid = (int)blockIdx.x - nlb;
+  bid = bid < nwf ? ncopy + nra + bid : bid < nwf + nra ? ncopy + (bid - nwf) : bid - nwf - nra;
+  if (bid < ncopy) {
+    const long nv = 5L * D * D / 4, i = (long)bid * FR_T + tid;
+    if (i >= nv) return;
+    const long e = i * 4, blk = e / (D * D), off = e % (D * D), r = off / D, c = off % D;
+    if (blk < 4) {
+      const long prow = (long)blk * W + (r / G.dh) * G.dhp + r % G.dh;
+      float* dst = (blk == 0 ? OQ : blk == 1 ? OKe : blk == 2 ? OV : OG) + off;
+      V4<float>::store(dst, V4<float>::load(DWP + prow * D + c));
+    } else {
+      V4<float>::store(OO + off, V4<float>::load(DWO + r * W + (c / G.dh) * G.dhp + c % G.dh));
+    }
+    return;
+  }
+  bid -= ncopy;
+  if (bid < nra) {
+    const int c = bid * 8 + (tid & 7), g = tid >> 3, split = 2 * D + W;
+    const bool waits = bid * 8 < 2 * D;
+    if (waits) {
+      if (tid == 0) {
+        unsigned seen;
+        for (;;) {
+          asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(seen) : "l"(&g_lnfin[0]) : "memory");
+          if ((int)seen >= ng) break;
+          __nanosleep(32);
+        }
+      }
+      __syncthreads();
+    }
+    float value = 0.f;
+    if (c < split) {
+#pragma unroll 4
+      for (int row = g; row < rows_a; row += FR_G) value += __ldcg(ACC + (long)row * width + c);
+    }
+    red[g * 8 + (tid & 7)] = value;
+    __syncthreads();
+    if (waits && tid == 0) {
+      const unsigned nwait = (unsigned)((2 * D + 7) / 8);
+      if (atomicAdd(&g_lnfin[1], 1u) == nwait - 1) { g_lnfin[0] = 0; g_lnfin[1] = 0; __threadfence(); }
+    }
+    if (tid < 8 && c < split) {
+      value = red[tid];
+      for (int k = 1; k < FR_G; ++k) value += red[k * 8 + tid];
+      if (c < D) OLW[c] = value;
+      else if (c < 2 * D) OLB[c - D] = value;
+      else {
+        const int rc = real_of(G, c - 2 * D);
+        if (rc >= 0) OBQ[rc] = value;
+      }
+    }
+    return;
+  }
+  bid -= nra;
+  const int c0 = bid * 8, cc = tid & 7, g = tid >> 3;
+  const float* base = ACC + 2 * D + W + c0 + cc;
+  float s[NH];
+#pragma unroll
+  for (int h = 0; h < NH; ++h) s[h] = 0.f;
+#pragma unroll 3
+  for (int row = g; row < rows_b; row += FR_G) {
+    float v[NH];
+#pragma unroll
+    for (int h = 0; h < NH; ++h) v[h] = base[(long)row * width + h * G.dp];
+#pragma unroll
+    for (int h = 0; h < NH; ++h) s[h] += v[h];
+  }
+  if (g >= HG) {
+#pragma unroll
+    for (int h = 0; h < NH; ++h) red[(h * HG + g - HG) * 8 + cc] = s[h];
+  }
+  __syncthreads();
+  if (g < HG) {
+#pragma unroll
+    for (int h = 0; h < NH; ++h) red[(h * HG + g) * 8 + cc] = s[h] + red[(h * HG + g) * 8 + cc];
+  }
+  __syncthreads();
+  if (tid < NH * 8) {
+    const int h = tid >> 3;
+    float t = red[(h * HG) * 8 + cc];
+    for (int k = 1; k < HG; ++k) t += red[(h * HG + k) * 8 + cc];
+    fin[h * 8 + cc] = t;
+    OWB[h * G.dp + c0 + cc] = t * LPW[c0 + cc];
+  }
+  __syncthreads();
+  if (tid < 8) {
+    float t = 0.f;
+    for (int h = 0; h < NH; ++h) t += fin[h * 8 + tid] * __bfloat162float(WB[h * G.dp + c0 + tid]);
+    OLPW[c0 + tid] = t;
+  }
+}
+// ln_bwd_p + finalize_red in one launch (ln_fin_k); the same arguments as the two
+void ln_fin(at::Tensor dxa, at::Tensor x, at::Tensor st, at::Tensor lw, at::Tensor dy, at::Tensor dx, at::Tensor dwp, at::Tensor dwo,
+            at::Tensor acc, at::Tensor wb, at::Tensor lpw, std::vector<at::Tensor> out, int64_t rows_a, int64_t rows_b) {
+  chk(dwp, at::kFloat, "dwp"); chk(dwo, at::kFloat, "dwo"); chk(wb, at::kBFloat16, "wb"); chk(lpw, at::kFloat, "lpw");
+  chk(dxa, at::kBFloat16, "dxa"); chk(x, at::kBFloat16, "x"); chk(dy, at::kBFloat16, "dy"); chk(dx, at::kBFloat16, "dx");
+  chk(lw, at::kFloat, "lw"); chk(st, at::kFloat, "stats");
+  const Geo G = geo(wb.size(0), dwp.size(1), wb.size(1));
+  const int64_t W = width(G), D = G.d, M = x.numel() / D;
+  TORCH_CHECK(lw.numel() == D, "ln_fin: ln weight [d_single]");
+  chk_acc(acc, G);
+  TORCH_CHECK(acc.dim() == 2, "ln_fin: block partial rows [rows, n]");
+  TORCH_CHECK(rows_a == (M + RW - 1) / RW && rows_b >= 1 && rows_a <= acc.size(0) && rows_b <= acc.size(0), "ln_fin: partial row counts");
+  TORCH_CHECK(dwp.numel() == 4 * W * D && dwo.numel() == D * W && lpw.numel() == G.dp, "ln_fin: dwp [4 W, D], dwo [D, W], lpw [d_pair]");
+  TORCH_CHECK(out.size() == 10, "ln_fin: 10 outputs");
+  for (int i = 0; i < 10; ++i) chk(out[i], at::kFloat, "ln_fin output");
+  const at::cuda::CUDAGuard gd(dwp.device());
+  const int ncopy = (int)((5L * D * D / 4 + FR_T - 1) / FR_T), nra = (int)((2 * D + W + 7) / 8), nwf = G.dp / 8;
+  const int nlb = (int)((rows_a + 3) / 4);
+#define LF_GO(NH, V)                                                                                                                       \
+  pdl_go(ln_fin_k<NH, V>, (unsigned)(nlb + ncopy + nra + nwf), FR_T, 0, CP<bf>(dxa), CP<bf>(x), CP<float2>(st), CP<float>(lw), CP<bf>(dy),  \
+      P<bf>(dx), (int)M, nlb, CP<float>(dwp), CP<float>(dwo), P<float>(acc), (int)acc.size(1),                                            \
+      (int)rows_a, (int)rows_b, CP<bf>(wb), CP<float>(lpw), P<float>(out[2]), P<float>(out[4]), P<float>(out[5]), P<float>(out[6]),        \
+      P<float>(out[7]), P<float>(out[0]), P<float>(out[1]), P<float>(out[3]), P<float>(out[9]), P<float>(out[8]), G, ncopy, nra)
+  if (D == 384) {
+    switch (G.nh) {
+      case 8: LF_GO(8, 3); break;
+      case 12: LF_GO(12, 3); break;
+      case 16: LF_GO(16, 3); break;
+      default: LF_GO(24, 3); break;
+    }
+  } else {
+    LF_GO(16, 4);
+  }
+#undef LF_GO
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
