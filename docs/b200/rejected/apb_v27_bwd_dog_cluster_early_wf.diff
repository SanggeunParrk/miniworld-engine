+template <typename T>
+__global__ void __launch_bounds__(256) prep_wf_k(const T* __restrict__ WB, const float* __restrict__ LPW, bf* __restrict__ WF, bf* __restrict__ WBO,
+                                                 int n, int dp, float ws) {
+  const int k = (int)blockIdx.x * 256 + threadIdx.x;
+  if (k >= n) return;
+  const float wb = rbf(static_cast<float>(WB[k]));
+  WF[k] = __float2bfloat16_rn(wb * LPW[k % dp] * ws);
+  WBO[k] = __float2bfloat16_rn(wb);
