+      unsigned v;
+      do { asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(v) : "l"(&g_pb_cnt[0]) : "memory"); } while (v < gridDim.x);
+    }
+    __syncthreads();
+    float* red = reinterpret_cast<float*>(smem);                           // [NH][HG][8] (the stages are idle)
+    float* fin = red + NH * HG * 8;                                         // [NH][8]
+    const int c0 = tk * 8, rows_b = (int)gridDim.x;
+    auto group = [&](int w, float (&s)[NH]) {                               // worker w = g * 8 + cc: rows g, g + 64, ...
+      const int cc = w & 7, g = w >> 3;
+      const float* base = AWF + c0 + cc;
+#pragma unroll
+      for (int h = 0; h < NH; ++h) s[h] = 0.f;
+#pragma unroll 3
+      for (int row = g; row < rows_b; row += NG) {
+        float v[NH];
+#pragma unroll
+        for (int h = 0; h < NH; ++h) v[h] = __ldcg(base + (long)row * acc_stride + h * DP);
+#pragma unroll
+        for (int h = 0; h < NH; ++h) s[h] += v[h];
+      }
+    };
+    for (int w = HG * 8 + tid; w < NG * 8; w += NTHR) {                    // the upper groups
+      float s[NH];
+      group(w, s);
+      const int cc = w & 7, g = w >> 3;
+#pragma unroll
+      for (int h = 0; h < NH; ++h) red[(h * HG + g - HG) * 8 + cc] = s[h];
+    }
+    __syncthreads();
+    for (int w = tid; w < HG * 8; w += NTHR) {                              // the lower groups, each plus its upper partner
+      float s[NH];
+      group(w, s);
+      const int cc = w & 7, g = w >> 3;
+#pragma unroll
+      for (int h = 0; h < NH; ++h) red[(h * HG + g) * 8 + cc] = s[h] + red[(h * HG + g) * 8 + cc];
+    }
+    __syncthreads();
+    if (tid < NH * 8) {
+      const int h = tid >> 3, cc = tid & 7;
+      float t = red[(h * HG) * 8 + cc];
+      for (int k = 1; k < HG; ++k) t += red[(h * HG + k) * 8 + cc];
+      fin[h * 8 + cc] = t;
+      OWB[h * DP + c0 + cc] = t * LPWF[c0 + cc];
+    }
+    __syncthreads();
+    if (tid < 8) {
+      float t = 0.f;
+      for (int h = 0; h < NH; ++h) t += fin[h * 8 + tid] * __bfloat162float(WBF[h * DP + c0 + tid]);
+      OLPW[c0 + tid] = t;
+    }
+    __syncthreads();
+    if (tid == 0) {
+      __threadfence();
+      if (atomicAdd(&g_pb_cnt[1], 1u) == NWF - 1) { atomicExch(&g_pb_cnt[0], 0u); atomicExch(&g_pb_cnt[1], 0u); __threadfence(); }
+    }
+  }
+#endif
 }
