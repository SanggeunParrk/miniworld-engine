+def ctab32(c, w, bias, gammas=(), grp=0, sigmask=0, silu=False, eps=1e-5, out=None):
+    """The inference conditioning tables in one launch (``ctab_tf32.cu``): out[:, j] = act(op_g(c) @ w[j]^T + bias[j]), g = j // grp
+    (grp 0: one group), op_g(c) = LN(c) * gammas[g] when gammas[g] is not None, else silu(c) (``silu``) or c; sigmoid on the 128-column
+    blocks set in sigmask. c fp32 [M, 128] (M a multiple of 128), w the tf32-rounded K-major pack [N, 128]. Bit for bit ``ln32`` (or
+    ``silu32``) + the grouped ``gemm32`` it replaces."""
+    import os
+
+    M, N = c.shape[0], w.shape[0]
+    d = _dev(c)
+    assert c.dtype == F32 and c.is_contiguous() and c.shape[1] == DM and M % 128 == 0 and w.shape[1] == DM, (c.shape, w.shape)
+    g = list(gammas) + [None] * (4 - len(gammas))
+    assert len(g) == 4 and (grp == 0 or N <= 4 * grp)
+    nt = int(os.environ.get("MW_LD13_NT", "0"))
+    if nt == 0:  # the widest tile whose grid still covers ~the SMs (one tile a CTA)
+        nt = next((x for x in (256, 128) if (M // 128) * (N // x) >= num_sms(d) * 3 // 4 and (grp == 0 or grp % x == 0)), 64)
+    assert N % nt == 0 and (grp == 0 or grp % nt == 0), (N, nt, grp)
+    if out is None:
+        out = torch.empty(M, N, device=c.device, dtype=F32)
+    atom_kernel32("ctab", d)(
+        ((M // 128) * (N // nt), 1, 1),
+        (256, 1, 1),
+        _tm32(w, (32, nt)),
+        _tm32(out, (32, 32)),
+        c,
+        *g,
+        bias,
+        int(M),
+        int(N),
+        int(nt),
+        int(grp),
+        int(sigmask),
+        int(silu),
+        float(eps),
+    )
+    return out
+
+
 def round_tf32(t):
     """t (fp32) rounded to tf32, to nearest with ties away from zero (cvt.rna.tf32.f32): add half a tf32 ulp to the magnitude bits, drop
     the low 13. For the weight operands of gemm32, once per pack (kind::tf32 MMAs truncate)."""
