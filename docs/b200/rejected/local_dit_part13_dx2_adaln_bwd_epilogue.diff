+def gemm_adaln_bwd32(dab, wT, a, scale, dres, dscale, dshift, y=None, so=None, dso=None, eps=1e-5):
+    """dx = dab @ wT^T (N = 128) with ``adaln_bwd32`` as its epilogue (round 3 part 13, ``gemm_ab_tf32.cu``: dx never leaves the chip) ->
+    (da, dyo). One table row per activation row (no shared tables). Bit for bit gemm32 + adaln_bwd32."""
+    M, K = dab.shape
+    d = _dev(dab)
+    assert M % 128 == 0 and K % 32 == 0 and wT.shape == (DM, K) and scale.shape[0] == M and a.is_contiguous() and dab.is_contiguous()
+    da = _new(a)
+    dyo = _new(a) if y is not None else None
+    atom_kernel32("gemm_ab", d)(
+        (min(num_sms(d), M // 128), 1, 1),
+        (512, 1, 1),
+        _tm32(dab, (32, 128)),
+        _tm32(wT, (32, 128)),
+        int(M),
+        int(K),
+        a,
+        scale,
+        int(scale.stride(0)),
+        dres,
+        da,
+        dscale,
+        int(dscale.stride(0)),
+        dshift,
+        int(dshift.stride(0)),
+        y,
+        so,
+        int(so.stride(0)) if so is not None else 0,
+        dso,
+        int(dso.stride(0)) if dso is not None else 0,
+        dyo,
+        float(eps),
+    )
+    return da, dyo
+
+
