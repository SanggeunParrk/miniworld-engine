+def _pre_maps(a, W, mod, Q, K, V, G, X, mkv, XK):
+    """The ten tensor maps of the sm_100a pre_fwd builds (2-D, or 3-D for the BOX3 builds)."""
+    if _pre_box3():
+        return (
+            _rows3(a, DM, 2),
+            _map(W, [32, 4 * DM, 4], [DM * 2, 64], [32, 128, 4], swizzle=64),
+            _rows3(mod, 6 * DM, 4),
+            *(_rows3(t, DM, 2) for t in (Q, K, V, G, X)),
+            _rows3(mkv, 2 * DM, 4) if mkv is not None else _rows3(G, DM, 2),
+            _rows3(XK, DM, 2),
+        )
+    return (
+        _rows(a),
+        _map(W, [DM, 4 * DM], DM * 2, [32, 128], swizzle=64),
+        _rows(mod, 6 * DM),
+        *(_rows(t) for t in (Q, K, V, G, X)),
+        _rows(mkv, 2 * DM) if mkv is not None else _rows(G),
+        _rows(XK),
+    )
+
+
+def _pre_kernel(name, d):
+    return _box3_kernel(name, d) if _pre_box3() else atom_kernel(name, d)
+
