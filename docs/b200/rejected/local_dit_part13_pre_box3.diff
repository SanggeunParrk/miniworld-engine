+def _rows3(t, cols, nb):
+    """Row-major bf16 [M, cols] as 3-D [64, M, cols / 64] with 32 x 64 x nb boxes (the BOX3 builds: nb 128-B column blocks in one box)."""
+    assert t.stride(-1) == 1
+    return _map(t, [64, t.shape[0], cols // 64], [t.stride(0) * 2, 128], [64, 32, nb])
+
+
+def _pre_box3() -> bool:
+    """pre_fwd's BOX3 builds (round 3 part 13; MW_LD13_PB3=0: the 2-D maps, A / B)."""
+    import os
+
+    return os.environ.get("MW_LD13_PB3", "1") != "0"
+
