+// 2026-11-18 (round 3 part 15): local_bias_fwd_f32_early on a CAPPED persistent grid (pair_bias_early32(cap=)): a few SMs' worth of CTAs
+// stream the whole pair beside the projection kernel instead of competing for its SMs; each thread keeps 4 rows in flight (8 256-bit
+// loads), the per-row arithmetic is local_bias_fwd_f32's statement for statement (the same bits). The same launch contract as _early.
+DEVI void load_row_v8(const float* z, size_t r, float* x) {
+#pragma unroll
+  for (int h = 0; h < 2; ++h) {
+    uint32_t w[8];
+    asm volatile("ld.global.nc.v8.b32 {%0, %1, %2, %3, %4, %5, %6, %7}, [%8];"
+                 : "=r"(w[0]), "=r"(w[1]), "=r"(w[2]), "=r"(w[3]), "=r"(w[4]), "=r"(w[5]), "=r"(w[6]), "=r"(w[7]) : "l"(z + r * 16 + 8 * h));
+#pragma unroll
+    for (int i = 0; i < 8; ++i) x[8 * h + i] = __uint_as_float(w[i]);
+  }
+}
+extern "C" __global__ void __launch_bounds__(256)
+local_bias_fwd_f32_ec(const float* __restrict__ z, const void* __restrict__ wb, const void* __restrict__ gamma, float* __restrict__ bias,
+                      int rows, float eps, int is_bf16) {
+  asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+  __shared__ float sw[64];
+  load_w(sw, wb, gamma, is_bf16);
+  __syncthreads();
+  constexpr int RT = 4;
+  for (long long r0 = (long long)blockIdx.x * (256 * RT) + threadIdx.x; r0 < rows; r0 += (long long)gridDim.x * (256 * RT)) {
+    float x[RT][16];
+#pragma unroll
+    for (int j = 0; j < RT; ++j)
+      if (r0 + 256 * j < rows) load_row_v8(z, (size_t)(r0 + 256 * j), x[j]);
+#pragma unroll
+    for (int j = 0; j < RT; ++j) {
+      const long long r = r0 + 256 * j;
+      if (r >= rows) break;
+      float rstd;
+      normalise(x[j], eps, rstd);
+#pragma unroll
+      for (int h = 0; h < 4; ++h) {
+        float b = 0.f;
+#pragma unroll
+        for (int c = 0; c < 16; ++c) b = fmaf(sw[h * 16 + c], x[j][c], b);
+        bias[(size_t)h * rows + r] = b;
+      }
+    }
+  }
+  if (blockIdx.x == 0) asm volatile("griddepcontrol.wait;" ::: "memory");
+}
