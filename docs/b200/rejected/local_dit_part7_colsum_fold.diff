+// ---- B200 round 3 part 7 (2026-11-17, r3-local-dit): the table-gradient kernels with their column sums (the bias gradients) folded in.
+// A persistent grid of G blocks: block b takes table rows 8 b + warp, + 8 G, ... (each as f32_tail_bwd / f32_adaln_bwd do), keeps the column
+// sums of its rows' table gradients in registers and writes the block's partial row part[b][pc ..] (pld = part's row pitch) in a fixed order
+// (the 8 warps in order); the caller sums the G rows (``col_jobs``, in order): deterministic. pc < 0: that output's sums are not written.
+// No second read of the [M, 768] table gradient (``f32_colsum`` on it read 755 MB at 48 x 5120 atoms).
+DEVI void block_cols(float4 (&red)[8][32], int w, int lane, const float (&v)[4], float* __restrict__ out) {
+  red[w][lane] = make_float4(v[0], v[1], v[2], v[3]);
+  __syncthreads();
+  if (w == 0) {
+    float4 s = red[0][lane];
+#pragma unroll
+    for (int i = 1; i < 8; ++i) { const float4 u = red[i][lane]; s.x += u.x; s.y += u.y; s.z += u.z; s.w += u.w; }
+    *reinterpret_cast<float4*>(out + 4 * lane) = s;
+  }
+  __syncthreads();
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+f32_tail_bwd_cs(const float* __restrict__ dy, const float* __restrict__ t, const float* __restrict__ st, int stld, float* __restrict__ dt,
+                float* __restrict__ dst, int dstld, int M, int mrows, float* __restrict__ part, int pld, int pc) {
+  pdl_wait();
+  pdl_launch();
+  __shared__ float4 red[8][32];
+  const int w = threadIdx.x >> 5, lane = threadIdx.x & 31, ch = 4 * lane, nsamp = M / mrows;
+  float cs[4] = {0.f, 0.f, 0.f, 0.f};
+  for (int irow = blockIdx.x * 8 + w; irow < mrows; irow += gridDim.x * 8) {
+    float s[4], p[4] = {0.f, 0.f, 0.f, 0.f};
+    ld4(st + (size_t)irow * stld + ch, s);
+    for (int a = 0; a < nsamp; ++a) {
+      const size_t row = (size_t)a * mrows + irow;
+      float d[4], tv[4], o[4];
+      ld4(dy + row * C + ch, d);
+      ld4(t + row * C + ch, tv);
+#pragma unroll
+      for (int i = 0; i < 4; ++i) { o[i] = d[i] * s[i]; p[i] += d[i] * tv[i] * s[i] * (1.f - s[i]); }
+      st4(dt + row * C + ch, o);
+    }
+    st4(dst + (size_t)irow * dstld + ch, p);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) cs[i] += p[i];
+  }
+  if (pc >= 0) block_cols(red, w, lane, cs, part + (size_t)blockIdx.x * pld + pc);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+f32_adaln_bwd_cs(const float* __restrict__ a_, const float* __restrict__ sc, int scld, const float* __restrict__ dx, const float* __restrict__ dres,
+                 float* __restrict__ da, float* __restrict__ dsc, int dscld, float* __restrict__ dsh, int dshld, const float* __restrict__ y,
+                 const float* __restrict__ so, int sold, float* __restrict__ dso, int dsold, float* __restrict__ dyo, int M, float eps, int mrows,
+                 float* __restrict__ part, int pld, int pcsc, int pcsh, int pcso) {
+  pdl_wait();
+  pdl_launch();
+  __shared__ float4 red[8][32];
+  const int w = threadIdx.x >> 5, lane = threadIdx.x & 31, ch = 4 * lane, nsamp = M / mrows;
+  float csc[4] = {0.f, 0.f, 0.f, 0.f}, csh[4] = {0.f, 0.f, 0.f, 0.f}, cso[4] = {0.f, 0.f, 0.f, 0.f};
+  for (int irow = blockIdx.x * 8 + w; irow < mrows; irow += gridDim.x * 8) {
+    float s[4], g[4], psc[4] = {0.f, 0.f, 0.f, 0.f}, psh[4] = {0.f, 0.f, 0.f, 0.f}, pso[4] = {0.f, 0.f, 0.f, 0.f};
+    ld4(sc + (size_t)irow * scld + ch, s);
+    if (y != nullptr) ld4(so + (size_t)irow * sold + ch, g);
+    for (int a = 0; a < nsamp; ++a) {
+      const size_t row = (size_t)a * mrows + irow;
+      float x[4], d[4], dl[4], o[4];
+      ld4(a_ + row * C + ch, x);
+      ld4(dx + row * C + ch, d);
+      const float rstd = norm128(x, eps);
+#pragma unroll
+      for (int i = 0; i < 4; ++i) { dl[i] = d[i] * s[i]; psc[i] += d[i] * x[i] * s[i] * (1.f - s[i]); psh[i] += d[i]; }
+      ln_back(x, dl, rstd, o);
+      if (dres != nullptr) {
+        float r[4];
+        ld4(dres + row * C + ch, r);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) o[i] += r[i];
+      }
+      st4(da + row * C + ch, o);
+      if (y != nullptr) {
+        float yv[4], q[4];
+        ld4(y + row * C + ch, yv);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { pso[i] += o[i] * yv[i] * g[i] * (1.f - g[i]); q[i] = o[i] * g[i]; }
+        st4(dyo + row * C + ch, q);
+      }
+    }
+    st4(dsc + (size_t)irow * dscld + ch, psc);
+    st4(dsh + (size_t)irow * dshld + ch, psh);
+    if (y != nullptr) st4(dso + (size_t)irow * dsold + ch, pso);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) { csc[i] += psc[i]; csh[i] += psh[i]; cso[i] += pso[i]; }
+  }
+  float* pr = part + (size_t)blockIdx.x * pld;
+  if (pcsc >= 0) block_cols(red, w, lane, csc, pr + pcsc);
+  if (pcsh >= 0) block_cols(red, w, lane, csh, pr + pcsh);
+  if (pcso >= 0 && y != nullptr) block_cols(red, w, lane, cso, pr + pcso);
+}
