+// 2026-11-18 (round 3 part 9): local_bias_fwd as a programmatic dependent of the bf16 pre_fwd's late-release build (-DLATEREL: its
+// dependents start after its own grid-dependency wait, so everything before pre_fwd is complete), running BESIDE pre_fwd -- the bf16 twin of
+// lbias_tf32.cu's local_bias_fwd_f32_early, with the same contract: the caller makes z, the parameters and the output buffer before the
+// chain's launches (the writes before the wait touch nothing a running kernel reads); CTA 0 waits for pre_fwd before it exits, so the
+// attention (this grid's dependent) sees the projections complete. Same arithmetic as local_bias_fwd (same bits).
+extern "C" __global__ void __launch_bounds__(256, 8)
+local_bias_fwd_early(const __nv_bfloat16* __restrict__ z, const void* __restrict__ wb, const void* __restrict__ gamma, float* __restrict__ bias,
+                     int rows, float eps, int is_bf16) {
+  __shared__ float sw[64];
+  load_w(sw, wb, gamma, is_bf16);
+  __syncthreads();
+  for (int r = blockIdx.x * blockDim.x + threadIdx.x; r < rows; r += gridDim.x * blockDim.x) {
+    float x[16], rstd;
+    load_row(z, r, x);
+    normalise(x, eps, rstd);
+#pragma unroll
+    for (int h = 0; h < 4; ++h) {
+      float b = 0.f;
+#pragma unroll
+      for (int c = 0; c < 16; ++c) b += sw[h * 16 + c] * x[c];
+      bias[(size_t)h * rows + r] = b;
+    }
+  }
+  asm volatile("griddepcontrol.launch_dependents;" ::: "memory");     // after the rows: the attention CTAs (big shared memory, waiting
+  if (blockIdx.x == 0) asm volatile("griddepcontrol.wait;" ::: "memory");  // for this grid) must not take the SMs while bias rows remain
+}
