+    s = _side_streams(cur.device.index)[1]
+    fork = torch.cuda.Event()
+    fork.record(cur)
+    s.wait_event(fork)
+    K.save32k(((12 * n8 + 255) // 256, 1, 1), (256, 1, 1), p, int(n8), 12, stream=s.cuda_stream)
