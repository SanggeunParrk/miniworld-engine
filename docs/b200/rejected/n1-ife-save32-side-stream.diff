+def save32_side(saves):
+    """:func:`save32` launched on a side stream forked from the current one: (fp32 copies, join event). The copies are allocated on the current
+    stream (the backward uses them there); the caller keeps ``saves`` alive until the current stream has waited for the event."""
+    n = saves[0].numel()
+    assert len(saves) == 12 and n % 8 == 0 and all(t.numel() == n and t.dtype == torch.bfloat16 and t.is_contiguous() for t in saves)
