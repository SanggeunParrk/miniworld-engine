@@ -0,0 +1,36 @@
+// attn_dqkv_tf32.cu — r3-swa part 20: the window-attention backward's two passes (attn_dq_tf32.cu, attn_dkv_tf32.cu) in ONE launch:
+// CTAs 0 .. nq - 1 run the dQ pass (as CTAs 0 .. nq - 1 of a grid of nq), the rest the dK / dV pass (as CTAs 0 .. of a grid of their
+// own). Same code, same items, the same bits. Why: the two passes ran side by side as two launches, dK / dV on a side stream forked after
+// the out-projection kernel -- a cross-stream launch has no programmatic dependency, so its prologue (barriers, TMEM, item table) and its
+// first loads started only after the out-projection had ended. One launch on the main stream starts both under the out-projection (PDL).
+// Used where both passes fit the SMs at once (every CTA a wave of one).
+// SPDX-License-Identifier: Apache-2.0
+#include "sm100.cuh"
+
+#define ST 12
+namespace kq {
+#include "attn_dq_tf32.cu"
+}
+#undef ST
+#define ST 7
+namespace kk {
+#include "attn_dkv_tf32.cu"
+}
+#undef ST
+
+extern "C" __global__ void __launch_bounds__(512, 1)
+swa_attn_dqkv_tf32_sm100(const __grid_constant__ CUtensorMap mq, const __grid_constant__ CUtensorMap mdo,
+                         const __grid_constant__ CUtensorMap mk, const __grid_constant__ CUtensorMap mv,
+                         const __grid_constant__ CUtensorMap mkm, const __grid_constant__ CUtensorMap kmq,
+                         const __grid_constant__ CUtensorMap kmqm, const __grid_constant__ CUtensorMap kmk,
+                         const __grid_constant__ CUtensorMap kmv, const __grid_constant__ CUtensorMap kmdo,
+                         const __grid_constant__ CUtensorMap kmdom, const __grid_constant__ CUtensorMap mdp,
+                         const float* __restrict__ LSE, const float* __restrict__ DD, const int* __restrict__ SEQU,
+                         const float* __restrict__ PQS, const float* __restrict__ PKS, const float* __restrict__ COS,
+                         const float* __restrict__ SIN, int S, int N, int Bn, float scale, float eps, int nq) {
+  if ((int)blockIdx.x < nq)
+    kq::attn_dq_body((int)blockIdx.x, nq, mq, mdo, mk, mv, mkm, LSE, DD, SEQU, PQS, COS, SIN, mdp, S, N, Bn, scale, eps);
+  else
+    kk::attn_dkv_body((int)blockIdx.x - nq, (int)gridDim.x - nq, kmq, kmqm, kmk, kmv, kmdo, kmdom, LSE, DD, SEQU, PKS, COS, SIN, mdp, S, N,
+                      Bn, scale, eps);
+}
