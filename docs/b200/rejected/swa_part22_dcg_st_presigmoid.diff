+
+// r3-swa part 22: a = silu(c) (as swa_mod_silu_tf32[_c16]_sm100) and silu'(c)'s two factors S = sigmoid(c), T = 1 + c (1 - S) for the late
+// dc launch (dcg_tf32.cu reads them before its accumulator wait instead of computing 32 sigmoids a thread after the GEMM; the same
+// expressions: the same bits). Off the backward's chain (the side stream that makes a at the backward's start).
+extern "C" __global__ void __launch_bounds__(NWARP * 32)
+swa_mod_silu_st_sm100(const void* __restrict__ CIN, int c_bf16, float* __restrict__ A, float* __restrict__ S, float* __restrict__ T, int R) {
+  const int row = (int)blockIdx.x * NWARP + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+  if (row >= R) return;
+  const size_t o = (size_t)row * C + 4 * lane;
+  const float4 c = c_bf16 ? ldb4(reinterpret_cast<const uint16_t*>(CIN) + o) : *reinterpret_cast<const float4*>(reinterpret_cast<const float*>(CIN) + o);
+  const float sx = sigm(c.x), sy = sigm(c.y), sz = sigm(c.z), sw = sigm(c.w);
+  *reinterpret_cast<uint4*>(A + o) = make_uint4(tf32r(c.x * sigm(c.x)), tf32r(c.y * sigm(c.y)), tf32r(c.z * sigm(c.z)), tf32r(c.w * sigm(c.w)));
+  *reinterpret_cast<float4*>(S + o) = make_float4(sx, sy, sz, sw);
+  *reinterpret_cast<float4*>(T + o) = make_float4(1.f + c.x * (1.f - sx), 1.f + c.y * (1.f - sy), 1.f + c.z * (1.f - sz), 1.f + c.w * (1.f - sw));
+}
