+// ---- the conditioning gradient of ONE conditioning shared by the A samples (2026-11-18, part 10) ----
+// dc[l] = sum over the samples s of (LN_bwd(dchat[s L + l]) + dcg[s L + l]) in fp32, rounded once: what cond_bwd + the caller's
+// expand backward (a sum over the samples of the A rounded rows: one more launch on the step's tail) computed. Block (NTC, SY): row y
+// of the block takes the samples y, y + SY, ... in order, then the SY partial rows are added in y order (bitwise repeatable).
+template <typename CT, typename OT, typename AT, int SY>
+__global__ void __launch_bounds__(NTC * SY) cond_bwd_shared100_k(const AT* __restrict__ DCHAT, const AT* __restrict__ DCG,
+    const CT* __restrict__ C, const float2* __restrict__ CST, OT* __restrict__ DCO, int L, int A) {
+  constexpr int NW = NTC / 32;
+  __shared__ float red[SY][NW][2];
+  __shared__ float4 accs[SY][NTC];
+  const int tx = threadIdx.x, y = threadIdx.y, col = tx * 4, warp = tx / 32, lane = tx % 32, l = blockIdx.x;
+  const float4 c = V4<CT>::load(C + (long)l * DC + col);
+  float4 acc = make_float4(0.f, 0.f, 0.f, 0.f);
+  for (int s0 = 0; s0 < A; s0 += SY) {
+    const long r = (long)(s0 + y) * L + l;
+    const float4 dch = V4<AT>::load(DCHAT + r * DC + col), dcg = V4<AT>::load(DCG + r * DC + col);
+    const float2 st = CST[r];
+    const float4 ch = make_float4((c.x - st.x) * st.y, (c.y - st.x) * st.y, (c.z - st.x) * st.y, (c.w - st.x) * st.y);
+    const float a1 = warp_sum(sum4(dch)), a2 = warp_sum(sum4(mul4(dch, ch)));
+    if (lane == 0) { red[y][warp][0] = a1; red[y][warp][1] = a2; }
+    __syncthreads();
+    float m1 = 0.f, m2 = 0.f;
+#pragma unroll
+    for (int w = 0; w < NW; ++w) { m1 += red[y][w][0]; m2 += red[y][w][1]; }
+    m1 /= DC; m2 /= DC;
+    __syncthreads();
+    acc = add4(acc, make_float4(st.y * (dch.x - m1 - ch.x * m2) + dcg.x, st.y * (dch.y - m1 - ch.y * m2) + dcg.y,
+                                st.y * (dch.z - m1 - ch.z * m2) + dcg.z, st.y * (dch.w - m1 - ch.w * m2) + dcg.w));
+  }
+  if (SY > 1) {
+    accs[y][tx] = acc;
+    __syncthreads();
+    if (y != 0) return;
+#pragma unroll
+    for (int j = 1; j < SY; ++j) acc = add4(acc, accs[j][tx]);
+  }
+  V4<OT>::store(DCO + (long)l * DC + col, acc);
+}
+void cond_bwd_shared100(at::Tensor dchat, at::Tensor dcg, at::Tensor c, at::Tensor cst, at::Tensor dc, int64_t A) {
+  const long M = dchat.size(0), L = dc.numel() / DC;
+  TORCH_CHECK(dc.is_contiguous() && dc.numel() == L * DC && M == A * L && dchat.is_contiguous() && dcg.is_contiguous() &&
+              dchat.size(1) == DC && dcg.size(1) == DC && c.stride(-1) == 1 && c.stride(-2) == DC && c.size(-2) == L &&
+              cst.numel() == 2 * M, "cond_bwd_shared: dchat / dcg [A L, DC], c [.., L, DC] (sample 0 read), dc [L, DC]");
+  const at::cuda::CUDAGuard g(c.device());
+  const int sy = A % 8 == 0 ? 8 : A % 4 == 0 ? 4 : A % 2 == 0 ? 2 : 1;
+  TDT_DISPATCH(dchat.scalar_type(), AT, [&] { TDT_DISPATCH(c.scalar_type(), CT, [&] { TDT_DISPATCH(dc.scalar_type(), OT, [&] {
+    auto go = [&](auto k, int s) {
+      k<<<(int)L, dim3(NTC, s), 0, S()>>>(CP<AT>(dchat), CP<AT>(dcg), CP<CT>(c), CP<float2>(cst), P<OT>(dc), (int)L, (int)A);
+    };
+    if (sy == 8) go(cond_bwd_shared100_k<CT, OT, AT, 8>, 8);
+    else if (sy == 4) go(cond_bwd_shared100_k<CT, OT, AT, 4>, 4);
+    else if (sy == 2) go(cond_bwd_shared100_k<CT, OT, AT, 2>, 2);
+    else go(cond_bwd_shared100_k<CT, OT, AT, 1>, 1);
+  }); }); });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
