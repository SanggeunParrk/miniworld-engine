+def _grouped(lf, ns):
+    """B200 (part 10): the leaves ``ns`` of ``lf`` (same trailing shape, all present) re-made as consecutive row blocks of ONE fp32 buffer,
+    returned for a single GEMM to write (the per-leaf GEMMs and the final kernels write the same views); None otherwise (lf unchanged)."""
+    if not all(n in lf for n in ns) or len({lf[n].shape[1:] for n in ns}) != 1 or any(lf[n].dim() != 2 for n in ns):
+        return None
+    t0 = lf[ns[0]]
