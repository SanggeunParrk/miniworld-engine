+// a[i] [M, n_i], b[i] [M, k_i] (row stride free, unit column stride, 16-B aligned), c[i] [n_i, k_i] fp32 contiguous; w[i] / raw[i]
+// empty (plain) or the lnw epilogue's [k_i] / [n_i, k_i] fp32 with part rows prow0[i] + n_i / 128 of ``part`` [*, k_i]
+void wgrad100(std::vector<at::Tensor> a, std::vector<at::Tensor> b, std::vector<at::Tensor> c, std::vector<at::Tensor> w,
+              std::vector<at::Tensor> raw, at::Tensor part, std::vector<int64_t> prow0) {
+  const int np = a.size();
+  TORCH_CHECK(np >= 1 && np <= WG_MAXP && (int)b.size() == np && (int)c.size() == np && (int)w.size() == np && (int)raw.size() == np &&
+              (int)prow0.size() == np, "wgrad100: 1 - 12 problems");
+  const auto dt = a[0].scalar_type();
+  TORCH_CHECK(dt == at::kBFloat16 || dt == at::kFloat, "wgrad100: bf16 or fp32 operands");
+  WgArgs args{};
+  args.np = np; args.M = a[0].size(0);
+  TORCH_CHECK(args.M % WG_BK == 0, "wgrad100: rows a multiple of 32");
+  int tiles = 0;
+  for (int i = 0; i < np; ++i) {
+    TORCH_CHECK(a[i].scalar_type() == dt && b[i].scalar_type() == dt && a[i].dim() == 2 && b[i].dim() == 2 && a[i].size(0) == args.M &&
+                b[i].size(0) == args.M && a[i].stride(1) == 1 && b[i].stride(1) == 1, "wgrad100: operands [M, *] of one dtype");
+    const int n = a[i].size(1), k = b[i].size(1);
+    TORCH_CHECK(n % WG_BM == 0 && k % WG_BN == 0, "wgrad100: n, k multiples of 128");
+    TORCH_CHECK((reinterpret_cast<uintptr_t>(a[i].data_ptr()) % 16) == 0 && (reinterpret_cast<uintptr_t>(b[i].data_ptr()) % 16) == 0 &&
+                (a[i].stride(0) * a[i].element_size()) % 16 == 0 && (b[i].stride(0) * b[i].element_size()) % 16 == 0, "wgrad100: 16-B rows");
+    f32c(c[i], "wgrad100 c");
+    TORCH_CHECK(c[i].numel() == (int64_t)n * k, "wgrad100: c [n, k]");
+    WgProb& p = args.p[i];
+    p.a = a[i].data_ptr(); p.b = b[i].data_ptr(); p.c = P<float>(c[i]); p.lda = a[i].stride(0); p.ldb = b[i].stride(0);
+    p.n = n; p.k = k; p.tile0 = tiles; p.prow0 = prow0[i];
+    if (w[i].numel()) {
+      f32c(w[i], "wgrad100 w"); f32c(raw[i], "wgrad100 raw"); f32c(part, "wgrad100 part");
+      TORCH_CHECK(w[i].numel() == k && raw[i].numel() == (int64_t)n * k && part.size(1) == k && part.size(0) >= prow0[i] + n / WG_BM,
+                  "wgrad100: lnw operands");
+      p.w = CP<float>(w[i]); p.raw = CP<float>(raw[i]); p.part = P<float>(part);
+    }
+    tiles += (n / WG_BM) * (k / WG_BN);
+  }
