+  if (dt == at::kBFloat16) {
+    static bool once = [] { return cudaFuncSetAttribute(wgrad100_k<bf>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)wg_smem<bf>()) == cudaSuccess; }();
+    TORCH_CHECK(once, "wgrad100: shared memory");
+    wgrad100_k<bf><<<tiles, 256, wg_smem<bf>(), S()>>>(args);
+  } else {
+    static bool once = [] { return cudaFuncSetAttribute(wgrad100_k<float>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)wg_smem<float>()) == cudaSuccess; }();
+    TORCH_CHECK(once, "wgrad100: shared memory");
+    wgrad100_k<float><<<tiles, 256, wg_smem<float>(), S()>>>(args);
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
