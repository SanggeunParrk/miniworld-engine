+// ---- cond_bwd with the conditioning gradient in fp32 parts (2026-11-17, part 5): dchat = DA + DB, where DB = dG[:, 2D:] Wn[2D:] (the
+// transition AdaLN's blocks, complete after res_adaln_b_bwd) is made beside the attention backward and DA = dG[:, :2D] Wn[:2D] after
+// adaln_a_bwd; DCG = dGg Wg (fp32, also early). dc = LN_bwd(DA + DB) + DCG
+template <typename CT, typename OT>
+__global__ void __launch_bounds__(NTC) cond_bwd3_k(const float* __restrict__ DA, const float* __restrict__ DB, const float* __restrict__ DCG,
+    const CT* __restrict__ C, const float2* __restrict__ CST, OT* __restrict__ DCO, int M, int rpb, int Crows) {
+  __shared__ float red[NTC / 32];
+  const int col = threadIdx.x * 4;
+  for (long r = (long)blockIdx.x * rpb, re = min((long)M, r + rpb); r < re; ++r) {
+    const float4 dch = add4(V4<float>::load(DA + r * DC + col), V4<float>::load(DB + r * DC + col));
+    const float4 c = V4<CT>::load(C + (Crows ? r % Crows : r) * DC + col);
+    const float2 st = CST[r];
+    const float4 ch = make_float4((c.x - st.x) * st.y, (c.y - st.x) * st.y, (c.z - st.x) * st.y, (c.w - st.x) * st.y);
+    const float m1 = block_sum<NTC>(sum4(dch), red) / DC, m2 = block_sum<NTC>(sum4(mul4(dch, ch)), red) / DC;
+    const float4 dcg = V4<float>::load(DCG + r * DC + col);
+    V4<OT>::store(DCO + r * DC + col, make_float4(st.y * (dch.x - m1 - ch.x * m2) + dcg.x, st.y * (dch.y - m1 - ch.y * m2) + dcg.y,
+                                                  st.y * (dch.z - m1 - ch.z * m2) + dcg.z, st.y * (dch.w - m1 - ch.w * m2) + dcg.w));
+  }
+}
+void cond_bwd3(at::Tensor da, at::Tensor db, at::Tensor dcg, at::Tensor c, at::Tensor cst, at::Tensor dc) {
+  for (auto* t : {&da, &db, &dcg}) f32c(*t, "cond_bwd3 operand");
+  const int M = dc.size(0), Crows = c.stride(0) == 0 ? c.size(2) : M;
+  TORCH_CHECK(da.numel() == (int64_t)M * DC && db.numel() == da.numel() && dcg.numel() == da.numel(), "cond_bwd3: [M, DC] parts");
+  const at::cuda::CUDAGuard g(c.device());
+  TDT_DISPATCH(c.scalar_type(), CT, [&] {
+    TDT_DISPATCH(dc.scalar_type(), OT, [&] {
+      const RowGrid rg = row_grid<float>(cond_bwd3_k<CT, OT>, NTC, M);
+      cond_bwd3_k<CT, OT><<<rg.grid, NTC, 0, S()>>>(CP<float>(da), CP<float>(db), CP<float>(dcg), CP<CT>(c), CP<float2>(cst), P<OT>(dc), M,
+                                                   rg.rpb, Crows);
+    });
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
