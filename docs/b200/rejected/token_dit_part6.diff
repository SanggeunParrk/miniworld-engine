+// train_pack100 in two parts (round 3 part 6): outputs [o0, o1) only, into ``outs`` when given (the second call), else allocated (all 21, as
+// train_pack100 returns them). grid > 0: train_pack100s_k on that many CTAs (a part beside the chain leaves the other SMs to it); 0: the
+// full grid. The forward needs the outputs past 17 (Wo, [Wa; Wb], Ws) only after the attention core: the first part packs 0-17 on the
+// chain, the second the rest on a side stream. Each output's values are train_pack100's.
+std::vector<at::Tensor> train_pack100r(std::vector<at::Tensor> weights,bool qk,bool fp32,int o0,int o1,int grid,std::vector<at::Tensor> outs) {
+ TORCH_CHECK((D==768||D==1024)&&weights.size()==(qk?25:23),"native token pack: 768 or 1024 wide weights");
+ TORCH_CHECK(0<=o0&&o0<o1&&o1<=21&&(outs.empty()||outs.size()==21),"train_pack100r: output range / outs");
+ const at::cuda::CUDAGuard guard(weights[0].device());
+ TrainPack90 p{};p.qk=qk;
+ for(int j=0;j<(int)weights.size();++j){
+  TORCH_CHECK(weights[j].is_cuda()&&weights[j].is_contiguous()&&weights[j].device()==weights[0].device()&&(weights[j].scalar_type()==at::kFloat||weights[j].scalar_type()==at::kBFloat16),"native token weight layout/dtype");
+  p.src[j]=weights[j].data_ptr();p.sf[j]=weights[j].scalar_type()==at::kFloat;
+ }
+ std::vector<std::vector<int64_t>> shapes={{DC},{DC},{4*D,DC},{4*D,DC},{2*D,DC},{D},{D},{D},{D},
+ {4*D,D},{4*D},{HD},{HD},{DPW},{NHH,DPW},{NHH,DPW},{NHH,DPW},{NHH,DPW},{D,D},{2*HID,D},{D,HID}};
+ const int aliases[21]={6,14,-1,-1,-1,8,16,11,19,-1,-1,qk?23:-1,qk?24:-1,12,13,-1,-1,-1,5,-1,22};
+ const bool given=!outs.empty();int total=0;
+ for(int o=0;o<21;++o){
+  bool isact=(o==3||o==4||o==9||o==10||o==16||o==17||o>=18);
+  auto dt=isact&&!fp32?at::kBFloat16:at::kFloat;p.df[o]=dt==at::kFloat;
+  const int a=aliases[o];
+  const bool alias=a>=0&&weights[a].scalar_type()==dt;
+  if(!given)outs.push_back(alias?weights[a]:at::empty(shapes[o],weights[0].options().dtype(dt)));
+  if(alias||o<o0||o>=o1)continue;
+  TORCH_CHECK(outs[o].scalar_type()==dt&&outs[o].is_contiguous(),"train_pack100r: outs");
+  p.dst[o]=outs[o].data_ptr();p.size[o]=outs[o].numel();p.blocks[o]=(p.size[o]+1024*UNR-1)/(1024*UNR);total+=p.blocks[o];
+ }
+ if(total){
+  if(grid>0)train_pack100s_k<<<std::min(grid,total),256,0,S()>>>(p,total);
+  else train_pack100_k<<<total,256,0,S()>>>(p);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+ }
+ return outs;
+}
