index 000000000..c71ffbe61
--- /dev/null
+++ b/src/miniworld_engine/kernels/conditioned_transition/cuda/gemm32mc_sm100.cu
@@ -0,0 +1,149 @@
+// gemm32mc_sm100.cu -- fp32 (kind::tf32) GEMM for the token DiT's few-row fp32 inference steps on sm_100a (2026-11-17, round 3 part 7).
+//
+//   C[M, N] = X[M, K] W[N, K]^T (+ bias[N]), fp32 operands (truncated to TF32 by the tensor cores), fp32 accumulation and output.
+//
+// At 640 rows (five samples x L 128) cuBLAS's TF32 GEMMs run 60 - 120 CTAs, each streaming ~1 MB of fp32 operands from L2: they are
+// bound by the per-SM L2 intake, not by the MMAs. Here the MMA's M side is the weight (128 weight rows a CTA; TMEM lane = output
+// column, so a warp's 32 lanes store 32 consecutive columns of an output row: coalesced) and its N side BX activation rows, and a
+// cluster of CW x CX CTAs shares operands by TMA multicast: the CX CTAs on the same weight tile each load 128 / CX of its rows and
+// multicast them, the CW CTAs on the same activation tile each load BX / CW of its rows. Per SM the L2 intake drops from
+// (128 + BX) K 4 bytes to (128 / CX + BX / CW) K 4 bytes.
+//
+//   W  [N, K] fp32 (an nn.Linear weight as stored)   TMA box [32 (K), 128 / CX], 128-B swizzle (A operand, K-major)
+//   X  [M, K] fp32                                   TMA box [32 (K), BX / CW],  128-B swizzle (B operand, K-major)
+//
+// The cluster is 1-D on the launch (x): CTA rank r = rw + CW rx; cluster c covers weight tiles [cw0, cw0 + CW) and activation tiles
+// [cx0, cx0 + CX). A stage's slot is free again only when every CTA it was multicast to has consumed it: each CTA's MMA commit
+// arrives on the empty barrier of every CTA that feeds it (its CX row peers and CW column peers), so each empty barrier counts
+// CX + CW - 1 arrivals. Producer: lane s owns ring slot s (one thread issues ~1 TMA load per 600 clk). PDL: barriers, TMEM and the
+// first NST weight slices before griddepcontrol.wait, the activation loads after it.
+// SPDX-License-Identifier: Apache-2.0
+#include "sm100.cuh"
+using namespace s100;
+
+#ifndef BX
+#define BX 160
+#endif
+#ifndef CW
+#define CW 2
+#endif
+#ifndef CX
+#define CX 4
+#endif
+#ifndef NST
+#define NST 5
+#endif
+
+constexpr int BMW = 128, BK = 32;                                  // weight rows a CTA; K values per stage (one 128-B row)
+constexpr int A_SL = BMW / CX, B_SL = BX / CW;                     // rows of each box this CTA loads and multicasts
+constexpr int A_BYTES = BMW * BK * 4, B_BYTES = BX * BK * 4, STAGE = A_BYTES + B_BYTES;
+constexpr int O_BAR = NST * STAGE;
+constexpr int SMEM_BYTES = 1024 + O_BAR + 256;
+constexpr int CS = CW * CX;
+static_assert(STAGE % 1024 == 0 && SMEM_BYTES <= 232448, "shared memory budget");
+static_assert(A_SL % 8 == 0 && B_SL % 8 == 0 && BMW % CX == 0 && BX % CW == 0, "slices of whole 8-row swizzle groups");
+static_assert(BX % 16 == 0 && BX >= 16 && BX <= 256 && CS <= 16 && NST <= 32, "tile / cluster shape");
+constexpr uint32_t IDESC = idesc_tf32(BMW, BX);
+constexpr int TCOLS = BX <= 32 ? 32 : BX <= 64 ? 64 : BX <= 128 ? 128 : 256;
+
+extern "C" __global__ void __launch_bounds__(192, 1)
+gemm32mc_sm100(const __grid_constant__ CUtensorMap mw, const __grid_constant__ CUtensorMap mx, int M, int N, int K,
+               float* __restrict__ out, int ldo, const float* __restrict__ bias, int nwt) {
+  extern __shared__ __align__(1024) unsigned char raw[];
+  unsigned char* sm = (unsigned char*)(((uintptr_t)raw + 1023) & ~(uintptr_t)1023);
+  const uint32_t su = smem_u32(sm);
+  uint64_t* full = reinterpret_cast<uint64_t*>(sm + O_BAR);
+  uint64_t* empty = full + NST;
+  uint64_t* done = empty + NST;
+  uint32_t* tslot = reinterpret_cast<uint32_t*>(done + 1);
+
+  const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+  const int rank = blockIdx.x % CS, cl = blockIdx.x / CS;
+  const int rw = rank % CW, rx = rank / CW;
+  const int ncw = nwt / CW;                                        // clusters along the weight tiles
+  const int wt = (cl % ncw) * CW + rw, xt = (cl / ncw) * CX + rx;
+  const int n0 = wt * BMW, m0 = xt * BX;
+  // multicast masks: the CX CTAs on this weight tile (rw fixed), the CW CTAs on this activation tile (rx fixed)
+  uint16_t rowmask = 0, colmask = 0;
+#pragma unroll
+  for (int j = 0; j < CX; ++j) rowmask |= (uint16_t)(1u << (rw + CW * j));
+#pragma unroll
+  for (int i = 0; i < CW; ++i) colmask |= (uint16_t)(1u << (i + CW * rx));
+  const uint16_t feeds = rowmask | colmask;
+  const int nk = K / BK;
+
+  if (threadIdx.x == 0) {
+    for (int s = 0; s < NST; ++s) { mbar_init(&full[s], 1); mbar_init(&empty[s], CX + CW - 1); }
+    mbar_init(done, 1);
+    fence_barrier_init();
+    prefetch_map(&mw); prefetch_map(&mx);
+  }
+  if (warp == 1) { tmem_alloc(smem_u32(tslot), TCOLS); tmem_relinquish(); }
+  tc_fence_before();
+  cluster_sync();                                                  // every peer's barriers exist before the first multicast
+  tc_fence_after();
+  const uint32_t tmem = *tslot;
+
+  if (warp == 0) {                                                 // TMA producer: lane s owns ring slot s
+    auto load_w = [&](int s, int kb) {
+      const uint32_t a = su + s * STAGE + rx * (A_SL * 128);
+      if constexpr (CX > 1) tma_load_2d_mc(a, &mw, &full[s], kb * BK, n0 + rx * A_SL, rowmask);
+      else tma_load_2d(a, &mw, &full[s], kb * BK, n0);
+    };
+    auto load_x = [&](int s, int kb) {
+      const uint32_t b = su + s * STAGE + A_BYTES + rw * (B_SL * 128);
+      if constexpr (CW > 1) tma_load_2d_mc(b, &mx, &full[s], kb * BK, m0 + rw * B_SL, colmask);
+      else tma_load_2d(b, &mx, &full[s], kb * BK, m0);
+    };
+    const int pre = nk < NST ? nk : NST;
+    if (lane < pre) { mbar_expect_tx(&full[lane], STAGE); load_w(lane, lane); }   // weights: before the wait
+    pdl_wait();
+    if (lane < pre) load_x(lane, lane);
+    if (lane < NST) {
+      for (int i = NST + lane; i < nk; i += NST) {
+        mbar_wait(&empty[lane], ((i / NST) - 1) & 1);
+        mbar_expect_tx(&full[lane], STAGE);
+        load_w(lane, i);
+        load_x(lane, i);
+      }
+    }
+    __syncwarp();
+  } else if (warp == 1) {                                          // MMA issuer
+    for (int i = 0; i < nk; ++i) {
+      const int s = i % NST;
+      mbar_wait(&full[s], (i / NST) & 1);
+      tc_fence_after();
+      if (elect_one()) {
+        const uint32_t a = su + s * STAGE, b = a + A_BYTES;
+#pragma unroll
+        for (int k = 0; k < BK / 8; ++k) umma_ss_tf32(tmem, desc_k128(a + k * 32), desc_k128(b + k * 32), IDESC, (i | k) != 0);
+        if constexpr (CS > 1) tc_commit_mc(&empty[s], feeds);
+        else tc_commit(&empty[s]);
+        if (i == nk - 1) tc_commit(done);
+      }
+      __syncwarp();
+    }
+    pdl_launch();
+  } else {                                                         // warps 2-5: TMEM lane quarter q = 32 output columns
+    const int q = warp % 4, n = n0 + q * 32 + lane;
+    const float bn = (bias != nullptr && n < N) ? bias[n] : 0.f;
+    mbar_wait(done, 0);
+    tc_fence_after();
+#pragma unroll 1
+    for (int c = 0; c < BX; c += 32) {
+      uint32_t v[32];
+      tmem_ld32(tmem + ((uint32_t)(q * 32) << 16) + c, v);
+      tmem_wait_ld();
+      if (n < N) {
+#pragma unroll
+        for (int j = 0; j < 32; ++j) {
+          const int m = m0 + c + j;
+          if (m < M) out[(long)m * ldo + n] = __uint_as_float(v[j]) + bn;   // a warp: 32 consecutive columns of row m
+        }
+      }
+    }
+  }
+  tc_fence_before();
+  cluster_sync();                                                  // no peer still multicasts into / commits onto this CTA
+  if (warp == 1) { tc_fence_after(); tmem_dealloc(tmem, TCOLS); }
+}
