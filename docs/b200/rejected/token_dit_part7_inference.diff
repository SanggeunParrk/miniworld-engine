+// ---- the flat q / k LayerNorm (RoseTTAFold3), q and k of a row in one pass (2026-11-17, part 7) ----
+// token_dit_rows.cu qk_ln_rows_kernel loads k only after q's two block sums, four barrier pairs a row: here both halves are loaded
+// first and each sum pair shares one barrier pair. Per half the same warp sums, the same order over the warps, the same expressions:
+// the same bits.
+template <int NT>
+__device__ __forceinline__ float2 block_sum2(float u, float v, float* red) {
+  u = warp_sum(u); v = warp_sum(v);
+  const int w = threadIdx.x / 32, l = threadIdx.x % 32;
+  if (l == 0) { red[w] = u; red[NT / 32 + w] = v; }
+  __syncthreads();
+  float s = 0.f, t = 0.f;
+#pragma unroll
+  for (int i = 0; i < NT / 32; ++i) s += red[i];
+#pragma unroll
+  for (int i = 0; i < NT / 32; ++i) t += red[NT / 32 + i];
+  __syncthreads();
+  return make_float2(s, t);
+}
+
+template <int NT, typename T, bool RND>
+__global__ void __launch_bounds__(NT) qk_ln100_k(T* __restrict__ QK, long sq, const float* __restrict__ WQ, const float* __restrict__ BQ,
+    const float* __restrict__ WK, const float* __restrict__ BK, float eps) {
+  constexpr int DW = NT * 4;
+  __shared__ float red[2 * (NT / 32)];
+  const int col = threadIdx.x * 4;
+  T* p = QK + (long)blockIdx.x * sq + col;
+  const float4 x[2] = {V4<T>::load(p), V4<T>::load(p + DW)};
+  const float4 w[2] = {*reinterpret_cast<const float4*>(WQ + col), *reinterpret_cast<const float4*>(WK + col)};
+  const float4 o[2] = {*reinterpret_cast<const float4*>(BQ + col), *reinterpret_cast<const float4*>(BK + col)};
+  const float2 sm = block_sum2<NT>(x[0].x + x[0].y + x[0].z + x[0].w, x[1].x + x[1].y + x[1].z + x[1].w, red);
+  const float mean[2] = {sm.x / DW, sm.y / DW};
+  float a[2], b[2], c[2], d[2];
+#pragma unroll
+  for (int h = 0; h < 2; ++h) { a[h] = x[h].x - mean[h]; b[h] = x[h].y - mean[h]; c[h] = x[h].z - mean[h]; d[h] = x[h].w - mean[h]; }
+  const float2 sv = block_sum2<NT>(a[0] * a[0] + b[0] * b[0] + c[0] * c[0] + d[0] * d[0], a[1] * a[1] + b[1] * b[1] + c[1] * c[1] + d[1] * d[1], red);
+  const float rstd[2] = {rsqrtf(sv.x / DW + eps), rsqrtf(sv.y / DW + eps)};
+#pragma unroll
+  for (int h = 0; h < 2; ++h) {
+    float4 r = make_float4(a[h] * rstd[h] * w[h].x + o[h].x, b[h] * rstd[h] * w[h].y + o[h].y, c[h] * rstd[h] * w[h].z + o[h].z,
+                           d[h] * rstd[h] * w[h].w + o[h].w);
+    if constexpr (RND && std::is_same<T, float>::value) {
+      r.x = rowmath::rna_tf32(r.x); r.y = rowmath::rna_tf32(r.y); r.z = rowmath::rna_tf32(r.z); r.w = rowmath::rna_tf32(r.w);
+    }
+    V4<T>::store(p + h * DW, r);
+  }
+}
+
+// qk [M, >= 2d] rows (q = columns 0 .. d - 1, k = d .. 2d - 1; d = 768), fp32 [d] affine of each (token_dit_rows.cu qk_ln_rows' contract)
+void qk_ln100(at::Tensor qk, at::Tensor wq, at::Tensor bq, at::Tensor wk, at::Tensor bk, double eps, bool rnd) {
+  TORCH_CHECK(qk.dim() == 2 && qk.stride(1) == 1 && qk.size(1) >= 2 * 768 && qk.stride(0) % 4 == 0, "qk_ln100: qk [M, >= 1536] rows");
+  for (auto* w : {&wq, &bq, &wk, &bk}) TORCH_CHECK(w->scalar_type() == at::kFloat && w->is_contiguous() && w->numel() == 768, "qk_ln100: fp32 [768]");
+  const at::cuda::CUDAGuard g(qk.device());
+  TDT_DISPATCH(qk.scalar_type(), T, [&] {
+    auto kern = rnd ? qk_ln100_k<192, T, true> : qk_ln100_k<192, T, false>;
+    kern<<<(unsigned)qk.size(0), 192, 0, S()>>>(P<T>(qk), qk.stride(0), CP<float>(wq), CP<float>(bq), CP<float>(wk), CP<float>(bk), (float)eps);
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
