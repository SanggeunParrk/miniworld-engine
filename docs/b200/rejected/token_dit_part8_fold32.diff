+// ---- fp32 inference: the conditioning folded into ONE GEMM (2026-11-18, round 3 part 8; the bf16 CondFold of token_dit_rows.cu in
+// fp32). G [P, 6 D] = c [W1; W2]^T (TF32, no bias); the AdaLN table j of token tok is rstd_c (G_j - mean_c r_j) + b1_j (r = W1 1:
+// LN(c) W1^T + b1 without the LayerNorm pass and the second GEMM; SIG = false, the identity AdaLN, reads the raw c: G_j + b1_j), gate j
+// is G_{4 + j} + b2_j. The residual source is the fp32 block input xin itself (no copy). One row per block of NT threads (D = 4 NT).
+struct Fold32 {
+  const float* r;    // [4 D] W1 1
+  const float* b;    // [4 D] b1
+  const float* gb;   // [2 D] b2
+  float2* st;        // [P] (mean, rstd) of the conditioning rows
+  const float* gg;   // the gates of token 0: G + 4 D, or a second GEMM's output (gates beside the chain)
+  long sgg;          // its row stride
+};
+
+template <int NT>
+__device__ __forceinline__ float2 block_sum2_100(float2 v, float2* red) {
+  v.x = warp_sum(v.x); v.y = warp_sum(v.y);
+  const int w = threadIdx.x / 32, l = threadIdx.x % 32;
+  if (l == 0) red[w] = v;
+  __syncthreads();
+  float2 t = make_float2(0.f, 0.f);
+#pragma unroll
+  for (int i = 0; i < NT / 32; ++i) { t.x += red[i].x; t.y += red[i].y; }
+  __syncthreads();
+  return t;
+}
+
+// out = xhat rstd * f(ms) + mb, the tables (js, js + 1) of the row's G corrected by the conditioning stats s
+template <int NT, bool SIG>
+__device__ __forceinline__ void fold32_tab(float4 a, float rstd, const float* Gt, const Fold32& f, int js, float2 s, float* out) {
+  constexpr int D = NT * 4;
+  const int col = threadIdx.x * 4;
+  float4 m = V4<float>::load(Gt + js * D + col), h = V4<float>::load(Gt + (js + 1) * D + col);
+  const float4 bs = V4<float>::load(f.b + js * D + col), bb = V4<float>::load(f.b + (js + 1) * D + col);
+  if (SIG) {
+    const float4 rs = V4<float>::load(f.r + js * D + col), rb = V4<float>::load(f.r + (js + 1) * D + col);
+    m = make_float4(s.y * fmaf(-s.x, rs.x, m.x), s.y * fmaf(-s.x, rs.y, m.y), s.y * fmaf(-s.x, rs.z, m.z), s.y * fmaf(-s.x, rs.w, m.w));
+    h = make_float4(s.y * fmaf(-s.x, rb.x, h.x), s.y * fmaf(-s.x, rb.y, h.y), s.y * fmaf(-s.x, rb.z, h.z), s.y * fmaf(-s.x, rb.w, h.w));
+  }
+  m = add4(m, bs); h = add4(h, bb);
+  if (SIG) m = sig4(m);
+  V4<float>::store(out + col, make_float4(a.x * rstd * m.x + h.x, a.y * rstd * m.y + h.y, a.z * rstd * m.z + h.z, a.w * rstd * m.w + h.w));
+}
+
+template <int NT>
+__device__ __forceinline__ float4 fold32_gate(int tok, const Fold32& f, int j) {
+  constexpr int D = NT * 4;
+  const int col = threadIdx.x * 4;
+  return sig4(add4(V4<float>::load(f.gg + (long)tok * f.sgg + j * D + col), V4<float>::load(f.gb + j * D + col)));
+}
+
+// xa = AdaLN(xin) with the tables 0, 1 (TWO: xt with 2, 3 -- the parallel block's transition input); the conditioning row's stats from c
+// (stored at st[tok] by the rows tok < P)
+template <int NT, bool TWO, bool SIG>
+__global__ void __launch_bounds__(NT) fold32_in_k(const float* __restrict__ XIN, long sxin, const float* __restrict__ G, long sg,
+    const float* __restrict__ C, long sc, int dc, float* __restrict__ OUT, float* __restrict__ OUT2, int P, float eps, float ceps, Fold32 f) {
+  constexpr int D = NT * 4;
+  __shared__ float2 red[NT / 32];
+  const long row = blockIdx.x;
+  const int tok = row % P, col = threadIdx.x * 4;
+  const float4 x = V4<float>::load(XIN + row * sxin + col);
+  const bool on = SIG && col < dc;
+  const float4 v = on ? V4<float>::load(C + (long)tok * sc + col) : zero4();
+  const float2 m = block_sum2_100<NT>(make_float2(sum4(x), sum4(v)), red);
+  const float mean = m.x / D, cmean = SIG ? m.y / (float)dc : 0.f;
+  const float4 a = make_float4(x.x - mean, x.y - mean, x.z - mean, x.w - mean);
+  const float4 cv = on ? make_float4(v.x - cmean, v.y - cmean, v.z - cmean, v.w - cmean) : zero4();
+  const float2 q = block_sum2_100<NT>(make_float2(sum4(mul4(a, a)), sum4(mul4(cv, cv))), red);
+  const float rstd = rsqrtf(q.x / D + eps);
+  const float2 s = SIG ? make_float2(cmean, rsqrtf(q.y / (float)dc + ceps)) : make_float2(0.f, 1.f);
+  if (SIG && row < P && threadIdx.x == 0) f.st[tok] = s;
+  const float* Gt = G + (long)tok * sg;
+  fold32_tab<NT, SIG>(a, rstd, Gt, f, 0, s, OUT + row * D);
+  if (TWO) fold32_tab<NT, SIG>(a, rstd, Gt, f, 2, s, OUT2 + row * D);
+}
+
+// the sequential block's transition input: xa = AdaLN(xin + sigmoid(gA) ya) with the tables 2, 3
+template <int NT, bool SIG>
+__global__ void __launch_bounds__(NT) fold32_mid_k(const float* __restrict__ XIN, long sxin, const float* __restrict__ YA, long sya,
+    const float* __restrict__ G, long sg, float* __restrict__ OUT, int P, float eps, Fold32 f) {
+  constexpr int D = NT * 4;
+  __shared__ float red[NT / 32];
+  const long row = blockIdx.x;
+  const int tok = row % P, col = threadIdx.x * 4;
+  const float* Gt = G + (long)tok * sg;
+  float4 x = V4<float>::load(XIN + row * sxin + col);
+  const float4 y = V4<float>::load(YA + row * sya + col), g = fold32_gate<NT>(tok, f, 0);
+  x = make_float4(x.x + g.x * y.x, x.y + g.y * y.y, x.z + g.z * y.z, x.w + g.w * y.w);
+  const float mean = block_sum<NT>(sum4(x), red) / D;
+  const float4 a = make_float4(x.x - mean, x.y - mean, x.z - mean, x.w - mean);
+  const float rstd = rsqrtf(block_sum<NT>(sum4(mul4(a, a)), red) / D + eps);
+  fold32_tab<NT, SIG>(a, rstd, Gt, f, 2, SIG ? f.st[tok] : make_float2(0.f, 1.f), OUT + row * D);
+}
+
+// out = (xin + sigmoid(gA) ya) + sigmoid(gT) y: the sequential block's two residuals and the parallel block's one
+template <int NT>
+__global__ void __launch_bounds__(NT) fold32_out_k(const float* __restrict__ XIN, long sxin, const float* __restrict__ YA, long sya,
+    const float* __restrict__ Y, long sy, const float* __restrict__ G, long sg, float* __restrict__ OUT, int P, Fold32 f) {
+  constexpr int D = NT * 4;
+  const long row = blockIdx.x;
+  const int tok = row % P, col = threadIdx.x * 4;
+  const float* Gt = G + (long)tok * sg;
+  float4 x = V4<float>::load(XIN + row * sxin + col);
+  const float4 ya = V4<float>::load(YA + row * sya + col), ga = fold32_gate<NT>(tok, f, 0);
+  x = make_float4(x.x + ga.x * ya.x, x.y + ga.y * ya.y, x.z + ga.z * ya.z, x.w + ga.w * ya.w);
+  const float4 y = V4<float>::load(Y + row * sy + col), gt = fold32_gate<NT>(tok, f, 1);
+  x = make_float4(x.x + gt.x * y.x, x.y + gt.y * y.y, x.z + gt.z * y.z, x.w + gt.w * y.w);
+  V4<float>::store(OUT + row * D + col, x);
+}
+
+static void fold32_check(const at::Tensor& t, const char* name, int64_t rows, int64_t D) {
+  TORCH_CHECK(t.scalar_type() == at::kFloat && t.dim() == 2 && t.size(0) == rows && t.size(1) == D && t.stride(1) == 1 &&
+                  t.stride(0) % 4 == 0 && reinterpret_cast<uintptr_t>(t.data_ptr()) % 16 == 0,
+              "fold32: ", name, " fp32 [", rows, ", ", D, "], 16-byte aligned rows");
+}
+
+static Fold32 fold32_make(const at::Tensor& g, const at::Tensor& r, const at::Tensor& b, const at::Tensor& b2, const at::Tensor& st,
+                          int64_t D, const c10::optional<at::Tensor>& g2) {
+  // G [P, 6 D] (tables then gates), or G [P, >= 4 D] tables and g2 [P, 2 D] gates (the gates' GEMM beside the chain)
+  TORCH_CHECK(g.scalar_type() == at::kFloat && g.dim() == 2 && g.size(1) >= (g2.has_value() ? 4 : 6) * D && g.stride(1) == 1 &&
+                  g.stride(0) % 4 == 0 && reinterpret_cast<uintptr_t>(g.data_ptr()) % 16 == 0,
+              "fold32: G fp32 [P, 6 D] (or [P, 4 D] + g2)");
+  if (g2.has_value())
+    TORCH_CHECK(g2->scalar_type() == at::kFloat && g2->dim() == 2 && g2->size(0) == g.size(0) && g2->size(1) >= 2 * D && g2->stride(1) == 1 &&
+                    g2->stride(0) % 4 == 0 && reinterpret_cast<uintptr_t>(g2->data_ptr()) % 16 == 0,
+                "fold32: g2 fp32 [P, 2 D]");
+  for (const at::Tensor* t : {&r, &b, &b2})
+    TORCH_CHECK(t->scalar_type() == at::kFloat && t->is_contiguous() && t->numel() == (t == &b2 ? 2 : 4) * D, "fold32: r / b1 [4 D], b2 [2 D]");
+  TORCH_CHECK(st.scalar_type() == at::kFloat && st.is_contiguous() && st.numel() == 2 * g.size(0), "fold32: stats fp32 [P, 2]");
+  Fold32 f;
+  f.r = r.data_ptr<float>(); f.b = b.data_ptr<float>(); f.gb = b2.data_ptr<float>(); f.st = reinterpret_cast<float2*>(st.data_ptr());
+  f.gg = g2.has_value() ? g2->data_ptr<float>() : g.data_ptr<float>() + 4 * D;
+  f.sgg = g2.has_value() ? g2->stride(0) : g.stride(0);
+  return f;
+}
+
+#define FOLD32_NT(D, NT, ...)                                                                          \
+  [&] {                                                                                                \
+    TORCH_CHECK((D) == 768 || (D) == 1024, "fold32: width 768 or 1024");                              \
+    if ((D) == 768) { constexpr int NT = 192; return __VA_ARGS__(); }                                  \
+    constexpr int NT = 256; return __VA_ARGS__();                                                      \
+  }()
+
+void fold32_in(at::Tensor xin, at::Tensor g, at::Tensor c, at::Tensor r, at::Tensor b, at::Tensor b2, at::Tensor st, at::Tensor out,
+               c10::optional<at::Tensor> out2, double eps, double ceps, bool sig, c10::optional<at::Tensor> g2) {
+  const int64_t M = xin.size(0), D = xin.size(1), P = g.size(0), dc = c.size(1);
+  TORCH_CHECK(P > 0 && M % P == 0 && c.size(0) == P && dc <= D && dc % 4 == 0, "fold32_in: M a multiple of P, c [P, dc <= D]");
+  fold32_check(xin, "xin", M, D); fold32_check(out, "out", M, D);
+  TORCH_CHECK(c.scalar_type() == at::kFloat && c.stride(1) == 1 && c.stride(0) % 4 == 0 && reinterpret_cast<uintptr_t>(c.data_ptr()) % 16 == 0,
+              "fold32_in: c fp32, 16-byte aligned rows");
+  TORCH_CHECK(out.is_contiguous() && (!out2.has_value() || out2->is_contiguous()), "fold32_in: contiguous out / out2");
+  if (out2.has_value()) fold32_check(*out2, "out2", M, D);
+  const Fold32 f = fold32_make(g, r, b, b2, st, D, g2);
+  const at::cuda::CUDAGuard gd(xin.device());
+  float* o2 = out2.has_value() ? out2->data_ptr<float>() : nullptr;
+  FOLD32_NT(D, NT, [&] {
+    auto k = out2.has_value() ? (sig ? fold32_in_k<NT, true, true> : fold32_in_k<NT, true, false>)
+                              : (sig ? fold32_in_k<NT, false, true> : fold32_in_k<NT, false, false>);
+    k<<<(unsigned)M, NT, 0, at::cuda::getCurrentCUDAStream()>>>(xin.data_ptr<float>(), xin.stride(0), g.data_ptr<float>(), g.stride(0),
+        c.data_ptr<float>(), c.stride(0), (int)dc, out.data_ptr<float>(), o2, (int)P, (float)eps, (float)ceps, f);
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void fold32_mid(at::Tensor xin, at::Tensor ya, at::Tensor g, at::Tensor r, at::Tensor b, at::Tensor b2, at::Tensor st, at::Tensor out,
+                double eps, bool sig, c10::optional<at::Tensor> g2) {
+  const int64_t M = xin.size(0), D = xin.size(1), P = g.size(0);
+  TORCH_CHECK(P > 0 && M % P == 0 && out.is_contiguous(), "fold32_mid: M a multiple of P, contiguous out");
+  fold32_check(xin, "xin", M, D); fold32_check(ya, "ya", M, D); fold32_check(out, "out", M, D);
+  const Fold32 f = fold32_make(g, r, b, b2, st, D, g2);
+  const at::cuda::CUDAGuard gd(xin.device());
+  FOLD32_NT(D, NT, [&] {
+    auto k = sig ? fold32_mid_k<NT, true> : fold32_mid_k<NT, false>;
+    k<<<(unsigned)M, NT, 0, at::cuda::getCurrentCUDAStream()>>>(xin.data_ptr<float>(), xin.stride(0), ya.data_ptr<float>(), ya.stride(0),
+        g.data_ptr<float>(), g.stride(0), out.data_ptr<float>(), (int)P, (float)eps, f);
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void fold32_out(at::Tensor xin, at::Tensor ya, at::Tensor y, at::Tensor g, at::Tensor r, at::Tensor b, at::Tensor b2, at::Tensor st,
+                at::Tensor out, c10::optional<at::Tensor> g2) {
+  const int64_t M = xin.size(0), D = xin.size(1), P = g.size(0);
+  TORCH_CHECK(P > 0 && M % P == 0 && out.is_contiguous(), "fold32_out: M a multiple of P, contiguous out");
+  fold32_check(xin, "xin", M, D); fold32_check(ya, "ya", M, D); fold32_check(y, "y", M, D); fold32_check(out, "out", M, D);
+  const Fold32 f = fold32_make(g, r, b, b2, st, D, g2);
+  const at::cuda::CUDAGuard gd(xin.device());
+  FOLD32_NT(D, NT, [&] {
+    fold32_out_k<NT><<<(unsigned)M, NT, 0, at::cuda::getCurrentCUDAStream()>>>(xin.data_ptr<float>(), xin.stride(0), ya.data_ptr<float>(),
+        ya.stride(0), y.data_ptr<float>(), y.stride(0), g.data_ptr<float>(), g.stride(0), out.data_ptr<float>(), (int)P, f);
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
