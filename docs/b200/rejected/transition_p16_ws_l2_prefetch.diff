+// (part 16) WSP: an L2 prefetch of this CTA's 1 / gridDim share of the squeeze's Ws [D][H] (the squeeze CTAs load it cold, from
+// DRAM, at their own entry; at 3+ tiles they enter only as the expand CTAs leave). 1: before griddepcontrol.wait, 2: after it
+#ifndef WSP
+#define WSP 0
+#endif
+DEVI void prefetch_ws(const ACT* ws) {
+  constexpr long TOT = (long)D_ * H_ * 2;
+  const long per = ((TOT + gridDim.x - 1) / gridDim.x + 255) / 256 * 256, b0 = per * blockIdx.x;
+  if (b0 >= TOT) return;
+  const long n = TOT - b0 < per ? TOT - b0 : per;
+  asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" :: "l"(reinterpret_cast<const char*>(ws) + b0), "r"((uint32_t)n) : "memory");
+}
