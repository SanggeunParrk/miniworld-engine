diff --git a/src/miniworld_engine/kernels/transition/cuda/sm100/widths/tgate_wx.cu b/src/miniworld_engine/kernels/transition/cuda/sm100/widths/tgate_wx.cu
new file mode 100644
index 000000000..8120ef7a5
--- /dev/null
+++ b/src/miniworld_engine/kernels/transition/cuda/sm100/widths/tgate_wx.cu
@@ -0,0 +1,276 @@
+// tgate_wx.cu (S90, 32-unit chunks) -- the wide-width backward GATE at D = 256 (-DDIM=256, H = HID) with d_xn FUSED in.
+// Items are 32-unit hidden chunks: [a | b] (64 columns) + dh (32) = 96 tensor-memory columns, DOUBLE-buffered (the two gate warpgroups take the even / odd chunks),
+// next to the 256-column d_xn accumulator (448 of 512). Two chunks make a 64-unit pair: their dA / dB fill one [128][64] staging tile each (units 0..31 / 32..63),
+// stored by TMA (dab) and multiplied into d_xn += [dA_p | dB_p] [Wa_p^T; Wb_p^T] (M 256, N 256 over the pair, K 2 x 64, B = K-major tiles of [Wa; Wb]^T [D][2H]);
+// h goes straight from registers to global memory (no staging). At a tile's last pair the accumulator is drained (bf16, row per thread) to the d_xn tensor.
+// SPDX-License-Identifier: Apache-2.0
+#include "sm100.cuh"
+using namespace s100;
+
+#ifndef DIM
+#define DIM 256
+#endif
+#ifndef HID
+#define HID (4 * DIM)
+#endif
+constexpr int D_ = DIM, H_ = HID, HC = 32, NCH = H_ / HC, NPR = NCH / 2, ROWS = 128, NKB = D_ / 64;
+#ifndef NST_
+#define NST_ 4
+#endif
+constexpr int NST = NST_;
+constexpr int KBT = ROWS * 128;                                // one K-block of a 128-row tile: 16 KB
+constexpr int S_DY = 0, S_XN = KBT, S_WAB = 2 * KBT, S_WS = 2 * KBT + 4096, STAGE = 2 * KBT + 4096 + 2048;   // 38 KB
+constexpr int O_ST = 0, O_OUT = NST * STAGE;                   // staging: dA | dB, [128][64] each
+constexpr int O_W2 = O_OUT + 2 * KBT;                          // d_xn B operand of a pair: dA part | dB part, [128 d][64 units] each (this CTA's half of D)
+constexpr int O_BAR = O_W2 + 2 * KBT;
+constexpr int SMEM_BYTES = O_BAR + 1024;
+static_assert(SMEM_BYTES <= 232448, "shared memory budget");
+static_assert(STAGE % 1024 == 0 && O_OUT % 1024 == 0 && D_ == 256 && NCH % 2 == 0, "1 KB alignment of swizzled tiles");
+constexpr uint32_t IDESC_DH = idesc_bf16(256, 32), IDESC_AB = idesc_bf16(256, 64), IDESC_DX = idesc_bf16(256, 256);
+constexpr uint32_t T_BUF = 96, T_DX = 256;                     // buffer s: [a | b] at 96 s, dh at 96 s + 64
+
+struct Bars {
+  uint64_t full[NST], empty[NST];
+  uint64_t acc_full[2];                                        // both CTAs: buffer s complete
+  uint64_t acc_empty[2];                                       // leader: 8 gate warps (one warpgroup of each CTA) read buffer s
+  uint64_t staged, stage_free;                                 // local: the 8 gate warps staged a pair -> store thread -> staging read
+  uint64_t w2_full;                                            // leader: both CTAs' d_xn B operand of a pair
+  uint64_t stg_full;                                           // leader: the 16 gate warps staged a pair
+  uint64_t dxn_done;                                           // both CTAs: a pair's d_xn products done (staging and B operand free)
+  uint64_t dx_full, dx_empty;                                  // both CTAs / leader: d_xn accumulator of a tile complete / drained
+  uint32_t tmem;
+};
+
+DEVI void gate_pair16(uint32_t dh0, uint32_t dh1, uint32_t a0, uint32_t a1, uint32_t b0, uint32_t b1, uint32_t& hp, uint32_t& dap, uint32_t& dbp) {
+  const uint32_t gp = pack_bf16(__uint_as_float(dh0), __uint_as_float(dh1));
+  const f2 G = mk2(bf16lo(gp), bf16hi(gp)), A = mk2u(a0, a1), Bv = mk2u(b0, b1);
+  const f2 S = mk2(sigmoid_kit(__uint_as_float(a0)), sigmoid_kit(__uint_as_float(a1)));
+  const f2 L = mul2(A, S);
+  const f2 H = mul2(L, Bv), DB = mul2(G, L);
+  const f2 U = fma2(L, fma2(S, mk2(-1.f, -1.f), mk2(1.f, 1.f)), S);
+  const f2 DA = mul2(mul2(G, Bv), U);
+  hp = pack_bf16(lo2(H), hi2(H)); dap = pack_bf16(lo2(DA), hi2(DA)); dbp = pack_bf16(lo2(DB), hi2(DB));
+}
+
+// maps: dy, xn [M][D] (box 64 x 64); wst = Ws^T [H][D] (box 64 x 16); wa, wb [H][D] (box 64 x 32); dab [M][2H] (box 64 x 64); wabt = [Wa; Wb]^T [D][2H] (box 64 x 64)
+// h: [M][H] bf16, dxn: [M][D] bf16 (written from registers)
+extern "C" __global__ void __launch_bounds__(512, 1)
+transition_gate_wx_sm100(const __grid_constant__ CUtensorMap mdy, const __grid_constant__ CUtensorMap mxn,
+                         const __grid_constant__ CUtensorMap mwst, const __grid_constant__ CUtensorMap mwa,
+                         const __grid_constant__ CUtensorMap mwb, const __grid_constant__ CUtensorMap mdab,
+                         const __grid_constant__ CUtensorMap mwabt, uint8_t* __restrict__ hout, uint8_t* __restrict__ dxn, int tiles) {
+  extern __shared__ __align__(1024) uint8_t sm[];
+  const uint32_t su = smem_u32(sm);
+  Bars& B = *reinterpret_cast<Bars*>(sm + O_BAR);
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int cta = blockIdx.x, G = gridDim.x;
+  const int crank = (int)cluster_rank();
+  const bool leader = crank == 0;
+  auto count = [&](int k) { return (tiles > k) ? (tiles - k + G - 1) / G : 0; };
+  const int n_valid = count(cta), n_local = count(cta & ~1);   // the pair walks the leader's count; a short CTA repeats its last
+  const int nitem = n_local * NCH, npair = n_local * NPR;      // tile as a dummy whose results are not stored
+  auto tile_of = [&](int i) { return i < n_valid ? cta + i * G : (n_valid > 0 ? cta + (n_valid - 1) * G : 0); };
+
+  if (tid == 0) {
+    for (int s = 0; s < NST; ++s) { mbar_init(&B.full[s], 1); mbar_init(&B.empty[s], 1); }
+    for (int s = 0; s < 2; ++s) { mbar_init(&B.acc_full[s], 1); mbar_init(&B.acc_empty[s], 8); }
+    mbar_init(&B.staged, 8); mbar_init(&B.stage_free, 1);
+    mbar_init(&B.w2_full, 1); mbar_init(&B.stg_full, 16);
+    mbar_init(&B.dxn_done, 1); mbar_init(&B.dx_full, 1); mbar_init(&B.dx_empty, 16);
+    fence_barrier_init();
+    prefetch_map(&mdy); prefetch_map(&mxn); prefetch_map(&mwst); prefetch_map(&mwa); prefetch_map(&mwb); prefetch_map(&mdab); prefetch_map(&mwabt);
+  }
+  if (warp == 2) { tmem_alloc2(smem_u32(&B.tmem), 512); tmem_relinquish2(); }
+  tc_fence_before();
+  __syncthreads();
+  cluster_sync_relaxed();
+  tc_fence_after();
+  const uint32_t tmem = B.tmem;
+
+  if (warp < 4) setmaxnreg_dec<56>();
+  if (warp == 0) {
+    // ------------------------------------------------------------------------------------------ producer
+    if (lane == 0) {
+      const CUtensorMap* mab = leader ? &mwa : &mwb;
+      int st = 0;
+      auto w2 = [&](int p) {                                   // pair p's d_xn B operand, once the previous pair's d_xn products are done
+        if (p >= 1) mbar_wait(&B.dxn_done, (p - 1) & 1);
+        if (leader) mbar_expect_tx(&B.w2_full, 4 * KBT);
+        const int j = p % NPR;
+#pragma unroll
+        for (int t = 0; t < 2; ++t)
+#pragma unroll
+          for (int b = 0; b < 2; ++b)
+            tma_load_2d_2sm(su + O_W2 + t * KBT + b * 8192, &mwabt, &B.w2_full, t * H_ + j * 64, crank * 128 + b * 64);
+      };
+      for (int q = 0; q < nitem; ++q) {
+        const int i = q / NCH, j = q % NCH, row = tile_of(i) * ROWS;
+        for (int kb = 0; kb < NKB; ++kb, ++st) {
+          const int s = st % NST;
+          if (st >= NST) mbar_wait(&B.empty[s], ((st / NST) - 1) & 1);
+#ifdef NOA
+          if (leader) mbar_expect_tx(&B.full[s], 2 * (STAGE - 2 * KBT));
+          const uint32_t base = su + O_ST + s * STAGE;
+#else
+          if (leader) mbar_expect_tx(&B.full[s], 2 * STAGE);
+          const uint32_t base = su + O_ST + s * STAGE;
+#pragma unroll
+          for (int h = 0; h < 2; ++h) {
+            tma_load_2d_2sm(base + S_DY + h * 8192, &mdy, &B.full[s], kb * 64, row + h * 64);
+            tma_load_2d_2sm(base + S_XN + h * 8192, &mxn, &B.full[s], kb * 64, row + h * 64);
+          }
+#endif
+          tma_load_2d_2sm(base + S_WAB, mab, &B.full[s], kb * 64, j * HC);
+          tma_load_2d_2sm(base + S_WS, &mwst, &B.full[s], kb * 64, j * HC + crank * 16);
+        }
+        if (q >= 2 && !(q & 1)) w2(q / 2 - 1);                 // behind the next pair's first chunk so the ring keeps filling
+      }
+      if (npair > 0) w2(npair - 1);
+    }
+  } else if (warp == 1) {
+    // ------------------------------------------------------------------------------------------ MMA (leader)
+    if (leader) {
+      int st = 0;
+      auto dxn_mma = [&](int p) {                              // d_xn += [dA_p | dB_p] [Wa_p^T; Wb_p^T]
+        const int ip = p / NPR, jp = p % NPR;
+        mbar_wait_cl(&B.stg_full, p & 1);
+        mbar_wait(&B.w2_full, p & 1);
+        if (jp == 0 && ip >= 1) mbar_wait_cl(&B.dx_empty, (ip - 1) & 1);
+        tc_fence_after();
+        if (elect_one()) {
+#ifndef NODXN
+#pragma unroll
+          for (int t = 0; t < 2; ++t) {
+            const uint64_t da = desc_k128(su + O_OUT + t * KBT), db = desc_k128(su + O_W2 + t * KBT);
+#pragma unroll
+            for (int ks = 0; ks < 4; ++ks)
+              umma_ss2(tmem + T_DX, da + (uint64_t)(ks * 2), db + (uint64_t)(ks * 2), IDESC_DX, (jp > 0 || t > 0 || ks > 0) ? 1u : 0u);
+          }
+#endif
+          tc_commit2_mc(&B.dxn_done, 3);
+          if (jp == NPR - 1) tc_commit2_mc(&B.dx_full, 3);
+        }
+        __syncwarp();
+      };
+      for (int q = 0; q < nitem; ++q) {
+        const int s = q & 1, u = q >> 1;
+        if (q >= 2) mbar_wait_cl(&B.acc_empty[s], (u - 1) & 1);
+        for (int kb = 0; kb < NKB; ++kb, ++st) {
+          const int sg = st % NST;
+          mbar_wait(&B.full[sg], (st / NST) & 1);
+          tc_fence_after();
+          const uint32_t base = su + O_ST + sg * STAGE;
+          const uint64_t ddy = desc_k128(base + S_DY), dxn_ = desc_k128(base + S_XN);
+          const uint64_t dab = desc_k128(base + S_WAB), dws = desc_k128(base + S_WS);
+          if (elect_one()) {
+#pragma unroll
+            for (int ks = 0; ks < 4; ++ks) {
+              umma_ss2(tmem + s * T_BUF + 64, ddy + (uint64_t)(ks * 2), dws + (uint64_t)(ks * 2), IDESC_DH, (kb > 0 || ks > 0) ? 1u : 0u);
+              umma_ss2(tmem + s * T_BUF, dxn_ + (uint64_t)(ks * 2), dab + (uint64_t)(ks * 2), IDESC_AB, (kb > 0 || ks > 0) ? 1u : 0u);
+            }
+            tc_commit2_mc(&B.empty[sg], 3);
+            if (kb == NKB - 1) tc_commit2_mc(&B.acc_full[s], 3);
+          }
+          __syncwarp();
+        }
+        if (q >= 2 && !(q & 1)) dxn_mma(q / 2 - 1);
+      }
+      if (npair > 0) dxn_mma(npair - 1);
+    }
+  } else if ((warp >= 4 && warp < 8) || warp >= 12) {
+    // ------------------------------------------------------------------------------------------ gate: warps 4-7 even chunks, 12-15 odd chunks
+    setmaxnreg_inc<152>();
+    const uint32_t lb = (uint32_t)(warp & 3) * 32, r = lb + lane, trow = tmem + (lb << 16);
+    const int g = warp >= 12 ? 1 : 0;
+    auto drain = [&](int i) {                                  // tile i's d_xn: bf16, this thread's row, columns g * 128 ..
+      mbar_wait(&B.dx_full, i & 1);
+      tc_fence_after();
+      const long grow = (long)tile_of(i) * ROWS + r;
+      uint8_t* dst = dxn + (grow * D_ + g * 128) * 2;
+#pragma unroll
+      for (int c = 0; c < 4; ++c) {
+        uint32_t v[32];
+        tmem_ld32(trow + T_DX + g * 128 + c * 32, v);
+        tmem_wait_ld();
+        if (i < n_valid) {
+#pragma unroll
+          for (int e = 0; e < 4; ++e) {
+            uint4 o;
+            o.x = pack_bf16(__uint_as_float(v[8 * e + 0]), __uint_as_float(v[8 * e + 1]));
+            o.y = pack_bf16(__uint_as_float(v[8 * e + 2]), __uint_as_float(v[8 * e + 3]));
+            o.z = pack_bf16(__uint_as_float(v[8 * e + 4]), __uint_as_float(v[8 * e + 5]));
+            o.w = pack_bf16(__uint_as_float(v[8 * e + 6]), __uint_as_float(v[8 * e + 7]));
+#ifndef NODRAIN
+            stg128(dst + (c * 32 + e * 8) * 2, o);
+#endif
+          }
+        }
+      }
+      tc_fence_before();
+      __syncwarp();
+      if (lane == 0) mbar_arrive_remote_relaxed(&B.dx_empty, 0);
+    };
+    for (int q = g; q < nitem; q += 2) {
+      const int i = q / NCH, j = q % NCH, u = q >> 1, pp = q >> 1;
+      mbar_wait(&B.acc_full[g], u & 1);
+      tc_fence_after();
+      uint32_t dh[32], av[32], bv[32];
+      tmem_ld32(trow + g * T_BUF + 64, dh);
+      tmem_ld32(trow + g * T_BUF, av);
+      tmem_ld32(trow + g * T_BUF + 32, bv);
+      tmem_wait_ld();
+      tc_fence_before();
+      __syncwarp();
+      if (lane == 0) mbar_arrive_remote_relaxed(&B.acc_empty[g], 0);
+      uint32_t hq[16], daq[16], dbq[16];
+#pragma unroll
+      for (int k = 0; k < 16; ++k) gate_pair16(dh[2 * k], dh[2 * k + 1], av[2 * k], av[2 * k + 1], bv[2 * k], bv[2 * k + 1], hq[k], daq[k], dbq[k]);
+      if (i < n_valid) {                                       // h straight to global memory: 64 contiguous bytes of this thread's row
+        uint8_t* hp = hout + (((long)tile_of(i) * ROWS + r) * H_ + (long)j * HC) * 2;
+#pragma unroll
+        for (int qq = 0; qq < 4; ++qq) stg128(hp + qq * 16, make_uint4(hq[qq * 4], hq[qq * 4 + 1], hq[qq * 4 + 2], hq[qq * 4 + 3]));
+      }
+      if (pp >= 1) { mbar_wait(&B.stage_free, (pp - 1) & 1); mbar_wait(&B.dxn_done, (pp - 1) & 1); }   // staging: stored and d_xn-multiplied
+      const uint32_t ob = su + O_OUT;
+#pragma unroll
+      for (int qq = 0; qq < 4; ++qq) {
+        const uint32_t off = sw128(r, g * 4 + qq);
+        sts128(ob + off, make_uint4(daq[qq * 4], daq[qq * 4 + 1], daq[qq * 4 + 2], daq[qq * 4 + 3]));
+        sts128(ob + KBT + off, make_uint4(dbq[qq * 4], dbq[qq * 4 + 1], dbq[qq * 4 + 2], dbq[qq * 4 + 3]));
+      }
+      fence_proxy_async();
+      __syncwarp();
+      if (lane == 0) { mbar_arrive(&B.staged); mbar_arrive_remote_cta(&B.stg_full, 0); }
+      if (j == g && i >= 1) drain(i - 1);                      // the previous tile's accumulator, while this tile's chunks run
+    }
+    if (nitem > 0) drain(n_local - 1);
+  } else if (warp == 8) {
+    // ------------------------------------------------------------------------------------------ stores of dA | dB, one pair at a time
+    if (lane == 0) {
+      for (int p = 0; p < npair; ++p) {
+        const int i = p / NPR, j = p % NPR;
+        mbar_wait(&B.staged, p & 1);
+        const uint32_t ob = su + O_OUT;
+        if (i < n_valid) {
+          const int row = tile_of(i) * ROWS;
+#pragma unroll
+          for (int h = 0; h < 2; ++h) {
+            tma_store_2d(&mdab, ob + h * 8192, j * 64, row + h * 64);
+            tma_store_2d(&mdab, ob + KBT + h * 8192, H_ + j * 64, row + h * 64);
+          }
+        }
+        tma_store_commit();
+        tma_store_wait_read0();
+        mbar_arrive(&B.stage_free);
+      }
+      tma_store_wait0();
+    }
+  }
+  tc_fence_before();
+  __syncthreads();
+  cluster_sync_relaxed();
+  if (warp == 2) { tc_fence_after(); tmem_dealloc2(tmem, 512); }
+}
+
+// ================================================================================== wiring surface
+extern "C" __device__ int transition_smem_bytes = SMEM_BYTES;
