+    float* red = reinterpret_cast<float*>(sm + G_RED);             // [warpgroup][pa, pb][128 rows]
+    const uint32_t tacc = trow + 256 + (uint32_t)wg * 128;
+    bool acc0 = true;                                              // no tile accumulated yet
+    auto load_dn = [&](uint32_t col, uint32_t (&dn)[16]) {
+      uint32_t v[32];
+      tmem_ld32(col, v);
+      tmem_wait_ld();
+#pragma unroll
+      for (int k = 0; k < 16; ++k) dn[k] = pack_bf16(__uint_as_float(v[2 * k]), __uint_as_float(v[2 * k + 1]));
+    };
+    auto acc32 = [&](uint32_t col, const float (&w)[32]) {         // TMEM columns col .. col + 31 of this row += w
+      uint32_t v[32];
+      if (!acc0) {
+        tmem_ld32(col, v);
+        tmem_wait_ld();
+#pragma unroll
+        for (int k = 0; k < 32; ++k) v[k] = __float_as_uint(__uint_as_float(v[k]) + w[k]);
+      } else {
+#pragma unroll
+        for (int k = 0; k < 32; ++k) v[k] = __float_as_uint(w[k]);
+      }
+      uint32_t lo[16], hi[16];
+#pragma unroll
+      for (int k = 0; k < 16; ++k) { lo[k] = v[k]; hi[k] = v[16 + k]; }
+      tmem_st16(col, lo);
+      tmem_st16(col + 16, hi);
+    };
+    for (int i = 0; i < n_local; ++i) {
+      const int b = i & 1, t = tile_of(i), grow = t * ROWS + (int)r;
+      const bool real = i < n_valid;
+      const uint32_t tdxn = trow + (uint32_t)b * 128;
+      const float rs = p.rstd[grow], mean = p.c1[grow] / rs;
+      if (t2 == 0 && i < 16) DXP(cta, 128 + 4 * i);
+      mbar_wait(&B.dxn_full[b], (i >> 1) & 1);
+      tc_fence_after();
+      mbar_wait(&B.xd_full[b], (i >> 1) & 1);
+      if (t2 == 0 && i < 16) DXP(cta, 128 + 4 * i + 1);
+      if (t2 == 0 && real) st_relaxed_gpu(p.flags + t, 0u);   // every load of this tile is done: reset its counter for the next call
+      const uint32_t dyb = su + G_XD + b * 65536, xb = dyb + 32768;
+      const f2 RS = mk2(rs, rs), NMR = mk2(-mean * rs, -mean * rs);
+      f2 pa2[2] = {mk2(0.f, 0.f), mk2(0.f, 0.f)}, pb2[2] = {mk2(0.f, 0.f), mk2(0.f, 0.f)};
+#pragma unroll
+      for (int gg = 0; gg < 2; ++gg) {
+        const int g = 2 * wg + gg;
+        uint32_t dn[16];
+        load_dn(tdxn + g * 32, dn);
+        float work[32];
+#pragma unroll
+        for (int qq = 0; qq < 4; ++qq) {
+          const uint4 xv = lds128_nv(xb + (g >> 1) * KB + sw128(r, (g & 1) * 4 + qq));
+          const uint32_t xw[4] = {xv.x, xv.y, xv.z, xv.w};
+#pragma unroll
+          for (int kk = 0; kk < 4; ++kk) {
+            const int e = qq * 4 + kk, pr = g * 16 + e;
+            const uint32_t n = dn[e];
+            const f2 N = mk2(bf16lo(n), bf16hi(n));
+            const f2 XH = fma2(mk2(bf16lo(xw[kk]), bf16hi(xw[kk])), RS, NMR);
+            const float2 gm = lds64f_nv(gam_u + pr * 8);
+            const f2 W = mul2(mk2(gm.x, gm.y), N);
+            pa2[kk & 1] = fma2(XH, W, pa2[kk & 1]); pb2[kk & 1] = add2(pb2[kk & 1], W);
+            const f2 NX = mul2(N, XH);
+            work[2 * e] = lo2(NX); work[2 * e + 1] = hi2(NX);
+          }
+        }
+        if (real) {
+          acc32(tacc + gg * 32, work);
+#pragma unroll
+          for (int e = 0; e < 16; ++e) { const uint32_t n = dn[e]; work[2 * e] = bf16lo(n); work[2 * e + 1] = bf16hi(n); }
+          acc32(tacc + 64 + gg * 32, work);
+        }
+      }
+      if (real) acc0 = false;
+      {
+        const f2 PA = add2(pa2[0], pa2[1]), PB = add2(pb2[0], pb2[1]);
+        red[(wg * 2 + 0) * 128 + r] = lo2(PA) + hi2(PA);
+        red[(wg * 2 + 1) * 128 + r] = lo2(PB) + hi2(PB);
+      }
+      named_bar_sync(1, 256);
+      const float ca = (red[r] + red[256 + r]) * (1.f / D_), cbv = (red[128 + r] + red[384 + r]) * (1.f / D_);
+      const f2 NCA = mk2(-ca, -ca), NCB = mk2(-cbv, -cbv);
+#pragma unroll
+      for (int gg = 0; gg < 2; ++gg) {
+        const int g = 2 * wg + gg;
+        uint32_t dn[16];
+        load_dn(tdxn + g * 32, dn);
+        if (gg == 1) {                                     // this warp's columns of the d_xn buffer are read (8 arrivals free it)
+          tc_fence_before();
+          __syncwarp();
+          if (lane == 0) mbar_arrive(&B.dxn_empty[b]);
+        }
+#pragma unroll
+        for (int qq = 0; qq < 4; ++qq) {
+          const uint32_t off = (g >> 1) * KB + sw128(r, (g & 1) * 4 + qq);
+          const uint4 xv = lds128(xb + off), dv = lds128(dyb + off);
+          const uint32_t xw[4] = {xv.x, xv.y, xv.z, xv.w}, dw[4] = {dv.x, dv.y, dv.z, dv.w};
+          uint32_t o[4];
+#pragma unroll
+          for (int k = 0; k < 4; ++k) {
+            const int pr = g * 16 + qq * 4 + k;
+            const uint32_t n = dn[qq * 4 + k];
+            const f2 XH = fma2(mk2(bf16lo(xw[k]), bf16hi(xw[k])), RS, NMR);
+            const float2 gm = lds64f(gam_u + pr * 8);
+            const f2 W = mul2(mk2(gm.x, gm.y), mk2(bf16lo(n), bf16hi(n)));
+            const f2 T = mul2(fma2(XH, NCA, add2(W, NCB)), RS);
+            const uint32_t tt = pack_bf16(lo2(T), hi2(T));
+            o[k] = pack_bf16(bf16lo(tt) + bf16lo(dw[k]), bf16hi(tt) + bf16hi(dw[k]));
+          }
+          sts128(dyb + off, make_uint4(o[0], o[1], o[2], o[3]));
+        }
+      }
+      tmem_wait_st();
+      fence_proxy_async();
+      named_bar_sync(2, 256);                              // dx of the whole tile staged; `red` free for the next tile
+      if (t2 == 0) {
+        if (real) {
+          tma_store_3d(p.dx3, dyb, 0, t * ROWS, 0);
+          tma_store_commit();
+          tma_store_wait_read0();
+        }
+        mbar_arrive(&B.xd_empty[b]);
+        if (i < 16) DXP(cta, 128 + 4 * i + 3);
+      }
+    }
+    // this CTA's dgamma | dbeta of the warp's 32 rows: lane l gets column l of each 32-column group
+    float* row = p.dgbw + ((size_t)cta * 4 + (warp & 3)) * 256;
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {                          // q: dgamma gg 0, 1, dbeta gg 0, 1
+      const int gg = q & 1, col = (q >> 1) * 128 + (2 * wg + gg) * 32 + lane;
+      float w[32];
+      if (!acc0) {
+        uint32_t v[32];
+        tmem_ld32(tacc + (q >> 1) * 64 + gg * 32, v);
+        tmem_wait_ld();
+#pragma unroll
+        for (int k = 0; k < 32; ++k) w[k] = __uint_as_float(v[k]);
+      } else {
+#pragma unroll
+        for (int k = 0; k < 32; ++k) w[k] = 0.f;
+      }
+      row[col] = reduce_scatter32(w, lane);
+    }
+    if (t2 == 0) tma_store_wait0();
+  }
+  tc_fence_before();
+  __syncthreads();
+  cluster_sync_relaxed();
+  if (warp == 2) { tc_fence_after(); tmem_dealloc(tmem, 512); }
+}
