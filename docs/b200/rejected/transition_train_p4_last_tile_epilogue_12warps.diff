+// (round 3, training part 4) the LayerNorm backward of a CTA's LAST tile on all twelve math warps: d_xn column groups [32 GB, 32 (GB + NG))
+// of this thread's row (the epilogue warps take groups 0-1, the two gate warpgroups 2 and 3 once their chunks are done; the last tile's
+// epilogue had run on four warps for 4.6 us while eight idled). The rows' pass-1 sums meet in `xs` (slot 0 epilogue, 1 / 2 the gate
+// warpgroups, added in slot order); the dgamma | dbeta column sums of the groups are returned in sg / sb (the same values as the
+// one-warpgroup epilogue: each group's sum is its own). Every one of the 384 math threads calls it between two bar 3 syncs.
+#ifndef LASTW
+#define LASTW 1
+#endif
+template <int GB, int NG>
+__device__ __noinline__ void ln_cols(uint32_t tdxn, uint32_t xb, uint32_t dyb, uint32_t gam_u, uint32_t r, int lane, float rs, float mean, float* xs, int slot,
+                  float (&sg)[4], float (&sb)[4]) {
+  auto load_dn = [&](uint32_t col, uint32_t (&dn)[16]) {
+    uint32_t v[32];
+    tmem_ld32(col, v);
+    tmem_wait_ld();
+#pragma unroll
+    for (int k = 0; k < 16; ++k) dn[k] = pack_bf16(__uint_as_float(v[2 * k]), __uint_as_float(v[2 * k + 1]));
+  };
+  const f2 RS = mk2(rs, rs), NMR = mk2(-mean * rs, -mean * rs);
+  f2 pa2[2] = {mk2(0.f, 0.f), mk2(0.f, 0.f)}, pb2[2] = {mk2(0.f, 0.f), mk2(0.f, 0.f)};
+#pragma unroll
+  for (int gg = 0; gg < NG; ++gg) {
+    const int g = GB + gg;
+    uint32_t dn[16];
+    load_dn(tdxn + g * 32, dn);
+    float work[32];
+#pragma unroll
+    for (int qq = 0; qq < 4; ++qq) {
+      const uint4 xv = lds128_nv(xb + (g >> 1) * KB + sw128(r, (g & 1) * 4 + qq));
+      const uint32_t xw[4] = {xv.x, xv.y, xv.z, xv.w};
+#pragma unroll
+      for (int kk = 0; kk < 4; ++kk) {
+        const int e = qq * 4 + kk, pr = g * 16 + e;
+        const uint32_t n = dn[e];
+        const f2 N = mk2(bf16lo(n), bf16hi(n));
+        const f2 XH = fma2(mk2(bf16lo(xw[kk]), bf16hi(xw[kk])), RS, NMR);
+        const float2 gm = lds64f_nv(gam_u + pr * 8);
+        const f2 W = mul2(mk2(gm.x, gm.y), N);
+        pa2[kk & 1] = fma2(XH, W, pa2[kk & 1]); pb2[kk & 1] = add2(pb2[kk & 1], W);
+        const f2 NX = mul2(N, XH);
+        work[2 * e] = lo2(NX); work[2 * e + 1] = hi2(NX);
+      }
+    }
+    sg[g] = reduce_scatter32(work, lane);
+#pragma unroll
+    for (int e = 0; e < 16; ++e) { const uint32_t n = dn[e]; work[2 * e] = bf16lo(n); work[2 * e + 1] = bf16hi(n); }
+    sb[g] = reduce_scatter32(work, lane);
+  }
+  {
+    const f2 PA = add2(pa2[0], pa2[1]), PB = add2(pb2[0], pb2[1]);
+    xs[slot * 256 + r] = lo2(PA) + hi2(PA);
+    xs[slot * 256 + 128 + r] = lo2(PB) + hi2(PB);
+  }
+  named_bar_sync(3, 384);
+  const float ca = (xs[r] + xs[256 + r] + xs[512 + r]) * (1.f / D_), cbv = (xs[128 + r] + xs[384 + r] + xs[640 + r]) * (1.f / D_);
+  const f2 NCA = mk2(-ca, -ca), NCB = mk2(-cbv, -cbv);
+#pragma unroll
+  for (int gg = 0; gg < NG; ++gg) {
+    const int g = GB + gg;
+    uint32_t dn[16];
+    load_dn(tdxn + g * 32, dn);
+#pragma unroll
+    for (int qq = 0; qq < 4; ++qq) {
+      const uint32_t off = (g >> 1) * KB + sw128(r, (g & 1) * 4 + qq);
+      const uint4 xv = lds128(xb + off), dv = lds128(dyb + off);
+      const uint32_t xw[4] = {xv.x, xv.y, xv.z, xv.w}, dw[4] = {dv.x, dv.y, dv.z, dv.w};
+      uint32_t o[4];
+#pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const int pr = g * 16 + qq * 4 + k;
+        const uint32_t n = dn[qq * 4 + k];
+        const f2 XH = fma2(mk2(bf16lo(xw[k]), bf16hi(xw[k])), RS, NMR);
+        const float2 gm = lds64f(gam_u + pr * 8);
+        const f2 W = mul2(mk2(gm.x, gm.y), mk2(bf16lo(n), bf16hi(n)));
+        const f2 T = mul2(fma2(XH, NCA, add2(W, NCB)), RS);
+        const uint32_t t = pack_bf16(lo2(T), hi2(T));
+        o[k] = pack_bf16(bf16lo(t) + bf16lo(dw[k]), bf16hi(t) + bf16hi(dw[k]));
+      }
+      sts128(dyb + off, make_uint4(o[0], o[1], o[2], o[3]));
+    }
+  }
+}
