+DEVI void tma_prefetch_2d(const CUtensorMap* m, int c0, int c1) {
+  asm volatile("cp.async.bulk.prefetch.tensor.2d.L2.global [%0, {%1, %2}];" :: "l"(m), "r"(c0), "r"(c1) : "memory");
+}
+DEVI void tmem_ld8(uint32_t taddr, uint32_t* r) {
+  asm volatile("tcgen05.ld.sync.aligned.32x32b.x8.b32 {%0,%1,%2,%3,%4,%5,%6,%7}, [%8];"
+               : "=r"(r[0]), "=r"(r[1]), "=r"(r[2]), "=r"(r[3]), "=r"(r[4]), "=r"(r[5]), "=r"(r[6]), "=r"(r[7]) : "r"(taddr) : "memory");
+}
+// (training part 5, G3) the DW gate on THREE warpgroups: warpgroup g takes the 8-unit chunks q0 .. q0 + NQ - 1 of the slice's 64 units
+// (warps 4-7: 0-2, 12-15: 3-5, the partial-store warps 8-11: 6-7, idle until the CTA's last tile before). Per tile: TMEM loads, the
+// gate_read arrival, all arithmetic (gate_pair16), then the g_empty wait and the stores (GOV). Same values per unit: the same bits.
+template <int NQ>
+DEVI void dw_gate3(uint8_t* sm, uint32_t su, uint32_t tmem, int n_local, int warp, int lane, int q0) {
+  BarsW& B = *reinterpret_cast<BarsW*>(sm + W_BAR);
+  constexpr uint32_t T_DH = 0, T_AB = 64;
+  const uint32_t lb = (uint32_t)(warp & 3) * 32, r = lb + lane, trow = tmem + (lb << 16);
+  for (int i = 0; i < n_local; ++i) {
+    mbar_wait(&B.dhab_full, i & 1);
+    tc_fence_after();
+    uint32_t dh[8 * NQ], av[8 * NQ], bv[8 * NQ];
+#pragma unroll
+    for (int q = 0; q < NQ; ++q) {
+      const uint32_t col = (uint32_t)(q0 + q) * 8;
+      tmem_ld8(trow + T_DH + col, dh + 8 * q);
+      tmem_ld8(trow + T_AB + col, av + 8 * q);
+      tmem_ld8(trow + T_AB + 64 + col, bv + 8 * q);
+    }
+    tmem_wait_ld();
+    tc_fence_before(); __syncwarp(); if (lane == 0) mbar_arrive(&B.gate_read);
+    uint32_t hp[4 * NQ], dap[4 * NQ], dbp[4 * NQ];
+#pragma unroll
+    for (int k = 0; k < 4 * NQ; ++k)
+      gate_pair16(dh[2 * k], dh[2 * k + 1], av[2 * k], av[2 * k + 1], bv[2 * k], bv[2 * k + 1], hp[k], dap[k], dbp[k]);
+    if (i >= GDB) mbar_wait(&B.g_empty[i % GDB], ((i / GDB) - 1) & 1);
+#pragma unroll
+    for (int q = 0; q < NQ; ++q) {
+      const uint32_t off = sw128(r, q0 + q);
+      sts128(su + W_H + off, make_uint4(hp[4 * q], hp[4 * q + 1], hp[4 * q + 2], hp[4 * q + 3]));
+      sts128(su + W_DAB + off, make_uint4(dap[4 * q], dap[4 * q + 1], dap[4 * q + 2], dap[4 * q + 3]));
+      sts128(su + W_DAB + KB + off, make_uint4(dbp[4 * q], dbp[4 * q + 1], dbp[4 * q + 2], dbp[4 * q + 3]));
+    }
+    fence_proxy_async();
+    __syncwarp();
+    if (lane == 0) mbar_arrive(&B.g_full[i % GDB]);
+  }
+}
