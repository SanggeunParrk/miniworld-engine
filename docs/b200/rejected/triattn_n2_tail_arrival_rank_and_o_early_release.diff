+// B200 N2 (TG_RANK): arrival-ordered tile counts.  Rank q (the atomicInc order of the CTAs' starts) gets n_q = n_lo + #{j : q < cut_j} + [q < rem]
+// tiles, cut_j = G (2 (k - j) + 1) / (2 k), j = 1..k: a ramp of k tiles from the first arrival to the last; n_q is non-increasing in q, so round i
+// of the persistent loop is carried by the ranks [0, m_i) and its tiles are base_i + q (base_i = the sum of the earlier rounds' m).  k = 0: the
+// classic strided split (n_q = n_lo + [q < rem], tile = q + i G).
+__device__ unsigned int g_tg_ctr;
 __device__ unsigned long long g_tg_stamp[4][512];
+struct RankSplit {
+  int G, k, n_lo, rem, T[8];   // T: the k + 1 thresholds (the cuts and rem), descending
+  __device__ __forceinline__ void init(int ntiles, int grid, int kk) {
+    G = grid; k = kk;
+    if (k > 6 || ntiles < G * (k + 2)) k = 0;
+    int s = 0;
+    for (int j = 1; j <= k; ++j) { const int c = G * (2 * (k - j) + 1) / (2 * k); T[j - 1] = c; s += c; }
+    n_lo = (ntiles - s) / G;
+    rem = ntiles - s - G * n_lo;
+    int pos = k;
+    while (pos > 0 && T[pos - 1] < rem) { T[pos] = T[pos - 1]; --pos; }
+    T[pos] = rem;
+  }
+  __device__ __forceinline__ int count(int q) const {
+    int c = 0;
+#pragma unroll
+    for (int d = 0; d < 8; ++d) c += (d <= k && q < T[d]) ? 1 : 0;
+    return n_lo + c;
+  }
+  __device__ __forceinline__ int base(int i) const {   // first tile id of round i
+    if (i <= n_lo) return i * G;
+    int b = n_lo * G;
+    for (int d = 0; d < i - n_lo && d <= k; ++d) b += T[d];
+    return b;
+  }
+};
 __device__ __forceinline__ long long gtimer_tg() { long long t; asm volatile("mov.u64 %0, %globaltimer;" : "=l"(t)); return t; }
