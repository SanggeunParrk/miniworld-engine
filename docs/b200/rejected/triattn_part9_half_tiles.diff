+// halves -- so the CTAs that take a last-wave item do half a tile more than the others instead of a whole one (B200 2026-11-18: L256,
+// 512 tiles on 148 CTAs: 3 or 4 tiles a CTA -> 3 or 3.5).  -> the item count; MINIWORLD_TRIATTN_B200_HALF=0 turns it off.
+inline int hsplit(int ntiles, int nsm, int& nfull) {
+  static const bool on = [] { const char* e = std::getenv("MINIWORLD_TRIATTN_B200_HALF"); return !(e && e[0] == '0'); }();
