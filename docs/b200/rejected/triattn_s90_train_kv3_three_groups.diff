+  const int total = mytasks * SPT;
+
+  if (warp == 0) {
+    if (lane == 0) {
+      int lt = 0, y = 0;
+      for (int t = blockIdx.x; t < ntasks; t += gridDim.x, ++lt) {
+        int kt, g, bh; decode(t, kt, g, bh);
+        const int b_ = bh / H, h_ = bh % H, kb = lt & 1;
+        if (lt >= 2) wait(A(kve + kb), ((lt >> 1) - 1) & 1);
+        expect_tx(A(kvf + kb), KR * 2 * KVT * 2);
