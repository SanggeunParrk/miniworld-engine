+  uint64_t* qe = qf + KB3_NQ;        // [NQ]
+  uint64_t* bf = qe + KB3_NQ;        // [NB]
+  uint64_t* be = bf + KB_NB;         // [NB] count 8
+  uint64_t* sf = be + KB_NB;         // [2]  buffer r's S^T | dP^T ready
