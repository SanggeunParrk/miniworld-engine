+        mma_ss_if(L, d, ak + 2, bq + 2, ID_ST, 1u);
+        mma_ss_if(L, d + 64, ak + KVM, bq + MAT, ID_ST, 0u);
+        mma_ss_if(L, d + 64, ak + KVM + 2, bq + MAT + 2, ID_ST, 1u);
+        mma_commit_if(L, sfa + r * 8);
+        if (w == SPT - 1) mma_commit_if(L, kvea + kb * 8);
