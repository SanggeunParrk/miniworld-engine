+    }
+  } else if (b < 4 * C + NH) {
+    const int h = b - 4 * C;
+    const float4 v = ssum(VECS + 4 * C + h * C, NVP);
+    if (ln == 0) __stcg(reinterpret_cast<float4*>(WS + 8 * C + h * C) + col, v);
+  } else {
