+  __shared__ float4 part[16][32];
+  __shared__ unsigned last;
+  // column `col` of a [nsp][stride] slot array at base: lane-strided sum, lanes added in order -> valid in warp 0
+  __shared__ float4 part2[16][32];
+  // column `col` of two [nsp][stride] slot arrays: lane-strided sums (every load of a lane in flight at once: a missing slot adds
+  // +0, which leaves the sum's bits), the lanes added in order -> valid in warp 0
+  float4 r1, r2;
+  auto ssum2 = [&](const float* b1, long s1, const float* b2, long s2) {
+    const float4* p1 = reinterpret_cast<const float4*>(b1) + col;
+    const float4* p2 = b2 ? reinterpret_cast<const float4*>(b2) + col : p1;
+    const long st1 = s1 / 4, st2 = s2 / 4;
+    float4 a = make_float4(0.f, 0.f, 0.f, 0.f), a2 = a;
+    for (int k0 = ln; k0 < nsp; k0 += 8 * 16) {
+      float4 v[8], w[8];
+#pragma unroll
+      for (int u = 0; u < 8; ++u) {
+        const bool ok = k0 + u * 16 < nsp;
+        v[u] = ok ? __ldg(p1 + (long)(k0 + u * 16) * st1) : make_float4(0.f, 0.f, 0.f, 0.f);
+        w[u] = ok && b2 ? __ldg(p2 + (long)(k0 + u * 16) * st2) : make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+#pragma unroll
+      for (int u = 0; u < 8; ++u) { add4(a, v[u]); add4(a2, w[u]); }
+    }
+    part[ln][col] = a; part2[ln][col] = a2;
+    __syncthreads();
