diff --git a/src/miniworld_engine/kernels/triangle_attention/cuda/b200_sources/tri_l128_bwd_sm100.cu b/src/miniworld_engine/kernels/triangle_attention/cuda/b200_sources/tri_l128_bwd_sm100.cu
