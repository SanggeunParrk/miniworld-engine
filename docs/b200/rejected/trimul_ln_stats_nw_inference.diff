+namespace wide {
+// (2026-11-18, r3-trimul pass 11) the small-M form of ln_stats_pdl_kernel with NWS warps per 64-token block instead of 8: each warp
+// sums H / NWS channels (all its loads in flight at once; the 8-warp form issued 64 dependent rounds at H 512 and read t at ~3 TB/s,
+// 5.3 us at bidirectional D256 L128 on the critical path between ctr and k3w), the NWS pivot-shifted partials merged in warp order
+// (Chan) as before. Not bitwise the 8-warp statistics (other partial boundaries), same arithmetic per partial.
+template <int H, int NWS>
+__global__ void __launch_bounds__(32 * NWS) ln_stats_pdl_nw_kernel(const __nv_bfloat16* __restrict__ t, float* __restrict__ mean,
+                                                                    float* __restrict__ rstd, int M, float eps) {
+  wa_pdl();
+  constexpr int CW = H / NWS, BT = 64;
+  __shared__ float pm[NWS][BT], pq[NWS][BT];
+  const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+  const int tok0 = blockIdx.x * BT + lane * 2;
+  const __nv_bfloat16* base = t + (size_t)(warp * CW) * M + tok0;
+  uint32_t w[CW];
+#pragma unroll
+  for (int k = 0; k < CW; ++k) w[k] = __ldg(reinterpret_cast<const unsigned int*>(base + (size_t)k * M));
+  const float p0 = bf_lo(w[0]), p1 = bf_hi(w[0]);
+  float s0 = 0.f, q0 = 0.f, s1 = 0.f, q1 = 0.f;
+#pragma unroll
+  for (int k = 1; k < CW; ++k) {
+    const float a = bf_lo(w[k]) - p0, c = bf_hi(w[k]) - p1;
+    s0 += a; q0 = fmaf(a, a, q0);
+    s1 += c; q1 = fmaf(c, c, q1);
+  }
+  pm[warp][lane * 2] = p0 + s0 * (1.f / CW);
+  pq[warp][lane * 2] = fmaxf(q0 - s0 * s0 * (1.f / CW), 0.f);
+  pm[warp][lane * 2 + 1] = p1 + s1 * (1.f / CW);
+  pq[warp][lane * 2 + 1] = fmaxf(q1 - s1 * s1 * (1.f / CW), 0.f);
+  __syncthreads();
+  for (int tk = threadIdx.x; tk < BT; tk += 32 * NWS) {
+    float N = 0.f, Mu = 0.f, Q = 0.f;
+#pragma unroll
+    for (int v = 0; v < NWS; ++v) {
+      const float nb = (float)CW, mb = pm[v][tk], qb = pq[v][tk];
+      const float nt = N + nb, d = mb - Mu;
+      Mu += d * (nb / nt);
+      Q += qb + d * d * (N * nb / nt);
+      N = nt;
+    }
+    mean[blockIdx.x * BT + tk] = Mu;
+    rstd[blockIdx.x * BT + tk] = rsqrt_ftz(Q * (1.f / H) + eps);
+  }
+}
+}  // namespace wide
+
+// The inference chain's statistics (b200_infer only; training keeps wide_ln_stats): nw 16 / 32 the NWS-warp form at any M (the caller
+// picks it by L, so a batch reads what each sample alone reads), anything else -> wide_ln_stats.
+void wide_ln_stats(torch::Tensor t, torch::Tensor mean, torch::Tensor rstd, double eps);
+void wide_ln_stats_inf(torch::Tensor t, torch::Tensor mean, torch::Tensor rstd, double eps, int64_t nw) {
+  using namespace wide;
+  const int H = (int)t.size(0), M = (int)(t.numel() / H);
+  if (M % 64 || !t.is_contiguous() || (nw != 16 && nw != 32)) { wide_ln_stats(t, mean, rstd, eps); return; }
+  auto T = reinterpret_cast<const __nv_bfloat16*>(t.data_ptr());
+  float *mo = mean.data_ptr<float>(), *ro = rstd.data_ptr<float>();
+  const float e = (float)eps;
+#define LNI(HH) if (H == HH) { if (nw == 32) wa_launch<1024>(ln_stats_pdl_nw_kernel<HH, 32>, M / 64, T, mo, ro, M, e); \
+                               else wa_launch<512>(ln_stats_pdl_nw_kernel<HH, 16>, M / 64, T, mo, ro, M, e); \
+                               C10_CUDA_KERNEL_LAUNCH_CHECK(); return; }
+  LNI(256) LNI(384) LNI(512) LNI(768) LNI(1024)
+#undef LNI
+  wide_ln_stats(t, mean, rstd, eps);
+}
