+// S90: the dWp GEMM's extra operand columns: rows R .. R + 7 of the t buffer [R + 8, M] = hi / lo bf16 splits of 1 / rs_o and mu_o (then zeros):
+// dpr^T [t | cols]^T gives r0 = sum_m dpr / rs_o, r1 = sum_m dpr mu_o next to dWp's own products (fp32 accumulation of bf16 x bf16 terms).
+namespace wide {
+__global__ void __launch_bounds__(256) r01_cols_kernel(const float* __restrict__ mu, const float* __restrict__ rs, __nv_bfloat16* __restrict__ out, int M) {
+  const int m = blockIdx.x * 256 + threadIdx.x;
+  if (m >= M) return;
+  const float ri = 1.f / rs[m], mv = mu[m];
+  const __nv_bfloat16 rh = __float2bfloat16_rn(ri), mh = __float2bfloat16_rn(mv);
+  out[m] = rh; out[(size_t)M + m] = __float2bfloat16_rn(ri - __bfloat162float(rh));
+  out[(size_t)2 * M + m] = mh; out[(size_t)3 * M + m] = __float2bfloat16_rn(mv - __bfloat162float(mh));
+  for (int k = 4; k < 8; ++k) out[(size_t)k * M + m] = __float2bfloat16_rn(0.f);
+}
+}  // namespace wide
+void wide_r01_cols(torch::Tensor mu, torch::Tensor rs, torch::Tensor out) {
+  const int M = (int)mu.numel();
+  TORCH_CHECK(rs.numel() == M && out.numel() == 8 * (int64_t)M && out.scalar_type() == torch::kBFloat16 && out.is_contiguous(), "wide_r01_cols");
+  wide::r01_cols_kernel<<<(M + 255) / 256, 256, 0, at::cuda::getCurrentCUDAStream()>>>(mu.data_ptr<float>(), rs.data_ptr<float>(),
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), M);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
