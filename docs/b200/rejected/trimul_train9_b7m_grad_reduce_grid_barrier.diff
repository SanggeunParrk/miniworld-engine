@@ -0,0 +1,101 @@
+// boundary cost: a chain of N PDL launches (128 CTAs x 512 threads, 1 CTA/SM, TMEM alloc + mbarrier init per launch) vs one
+// cooperative launch with N-1 grid barriers. Each stage: thread 0 of each CTA spins `ns` ns (globaltimer), then reads its
+// neighbour CTA's previous-stage word and writes its own (a cross-CTA dependency).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAStream.h>
+#include "sm100.cuh"
+using namespace sm100;
+
+DEV uint64_t gtime() { uint64_t t; asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); return t; }
+DEV uint32_t ld_acq(const uint32_t* p) { uint32_t v; asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory"); return v; }
+
+DEV void stage_work(int s, int ns, int* buf, int G) {
+  if (threadIdx.x == 0) {
+    const uint64_t t0 = gtime();
+    while (gtime() - t0 < (uint64_t)ns) {}
+    const int v = s ? ((volatile int*)buf)[(s - 1) * G + (blockIdx.x + 1) % G] : 0;
+    buf[s * G + blockIdx.x] = v + 1;
+  }
+  __syncthreads();
+}
+
+DEV void grid_sync(uint32_t* bar, uint32_t G) {
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    const uint32_t gen = ld_acq(bar + 1);
+    __threadfence();
+    if (atomicAdd(bar, 1u) == G - 1) { bar[0] = 0; __threadfence(); atomicAdd(bar + 1, 1u); }
+    else { while (ld_acq(bar + 1) == gen) {} }
+  }
+  __syncthreads();
+}
+
+struct Sh { uint64_t b[8]; uint32_t tmem; };
+
+__global__ void __launch_bounds__(512, 1) stage_k(int s, int ns, int* buf, int trig) {
+  extern __shared__ __align__(1024) uint8_t sm[];
+  Sh& S = *reinterpret_cast<Sh*>(sm);
+  if (trig) pdl_trigger();
+  if (threadIdx.x == 0) { for (int i = 0; i < 8; ++i) mbar_init(&S.b[i], 1); fence_mbar_init(); }
+  if (threadIdx.x / 32 == 2) { tmem_alloc(&S.tmem, 256); tmem_relinquish(); }
+  tc_fence_before(); __syncthreads(); tc_fence_after();
+  pdl_wait();
+  stage_work(s, ns, buf, gridDim.x);
+  tc_fence_before(); __syncthreads();
+  if (threadIdx.x / 32 == 2) tmem_dealloc(S.tmem, 256);
+}
+
+// monotonic counter: red.release arrive, ld.acquire poll until s * G; the last CTA out resets it (bar[2] counter, bar[3] exits)
+DEV void grid_sync2(uint32_t* bar, uint32_t target) {
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    asm volatile("red.release.gpu.global.add.u32 [%0], 1;" ::"l"(bar) : "memory");
+    while (ld_acq(bar) < target) {}
+  }
+  __syncthreads();
+}
+
+__global__ void __launch_bounds__(512, 1) coop_k(int n, int ns, int* buf, uint32_t* bar, int mode) {
+  extern __shared__ __align__(1024) uint8_t sm[];
+  Sh& S = *reinterpret_cast<Sh*>(sm);
+  if (threadIdx.x == 0) { for (int i = 0; i < 8; ++i) mbar_init(&S.b[i], 1); fence_mbar_init(); }
+  if (threadIdx.x / 32 == 2) { tmem_alloc(&S.tmem, 256); tmem_relinquish(); }
+  tc_fence_before(); __syncthreads(); tc_fence_after();
+  pdl_wait();
+  for (int s = 0; s < n; ++s) {
+    if (s) { if (mode) grid_sync2(bar + 2, s * gridDim.x); else grid_sync(bar, gridDim.x); }
+    stage_work(s, ns, buf, gridDim.x);
+  }
+  if (mode && threadIdx.x == 0 && atomicAdd(bar + 3, 1u) == gridDim.x - 1) { bar[2] = 0; bar[3] = 0; }
+  tc_fence_before(); __syncthreads();
+  if (threadIdx.x / 32 == 2) tmem_dealloc(S.tmem, 256);
+}
+
+constexpr int SMEM = 200 * 1024;
+
+void chain(int64_t n, int64_t ns, torch::Tensor buf, int64_t G, int64_t pdl) {
+  static bool a = false;
+  if (!a) { cudaFuncSetAttribute(stage_k, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM); a = true; }
+  auto st = at::cuda::getCurrentCUDAStream();
+  for (int s = 0; s < n; ++s) {
+    cudaLaunchConfig_t cfg = {};
+    cfg.gridDim = dim3(G); cfg.blockDim = dim3(512); cfg.dynamicSmemBytes = SMEM; cfg.stream = st;
+    cudaLaunchAttribute at[1];
+    at[0].id = cudaLaunchAttributeProgrammaticStreamSerialization; at[0].val.programmaticStreamSerializationAllowed = 1;
+    cfg.attrs = at; cfg.numAttrs = (pdl && s) ? 1 : 0;
+    C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, stage_k, (int)s, (int)ns, buf.data_ptr<int>(), (int)(pdl & 2 ? 1 : 0)));
+  }
+}
+
+void coop(int64_t n, int64_t ns, torch::Tensor buf, torch::Tensor bar, int64_t G, int64_t mode) {
+  static bool a = false;
+  if (!a) { cudaFuncSetAttribute(coop_k, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM); a = true; }
+  cudaLaunchConfig_t cfg = {};
+  cfg.gridDim = dim3(G); cfg.blockDim = dim3(512); cfg.dynamicSmemBytes = SMEM; cfg.stream = at::cuda::getCurrentCUDAStream();
+  cudaLaunchAttribute at[1];
+  at[0].id = cudaLaunchAttributeCooperative; at[0].val.cooperative = 1;
+  cfg.attrs = at; cfg.numAttrs = 1;
+  C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, coop_k, (int)n, (int)ns, buf.data_ptr<int>(), (uint32_t*)bar.data_ptr<int>(), (int)mode));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("chain", &chain); m.def("coop", &coop); }
