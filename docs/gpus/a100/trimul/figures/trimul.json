{
 "figures": {
  "inference": {
   "title": "A100 · TriMul · inference · D128, bf16, L a multiple of 16 (one direction: H = 128, P = 2H = 256 planes; bidirectional: H = 256, P = 512)",
   "panels": [
    {
     "label": "forward (nothing saved)",
     "kernels": [
      {
       "id": "P1",
       "name": "weight pack",
       "impl": "CUDA · pack_kernel",
       "code": [
        "w1 = bf16(0.5 W_in)   # K1's granule-major 64-row blocks",
        "W_g' = bf16(0.5 W_g diag γ), W_o' = bf16(0.5 W_o diag γ_o)",
        "s = Σ_k W', b = 0.5 W β   # folded LayerNorm affines"
       ],
       "reads": [
        "W_l, W_lg, W_r, W_rg (any strides)",
        "W_g, W_o",
        "γ, β, γ_o, β_o"
       ],
       "writes": [
        "w1, W_g', W_o'",
        "s, b (row sums, bias terms)"
       ]
      },
      {
       "id": "F1",
       "name": "input LN + gated proj",
       "impl": "CUDA · k1_kernel",
       "code": [
        "x_n = layer_norm(x, (128,), γ, β)",
        "m = mask[:, None] & mask[None, :]",
        "a = sigmoid(x_n W_lg^T) * (x_n W_l^T) * m",
        "b = sigmoid(x_n W_rg^T) * (x_n W_r^T) * m",
        "# channel-major planes [P, L, L]"
       ],
       "reads": [
        "x",
        "w1",
        "mask [L]",
        "γ, β"
       ],
       "writes": [
        "a | b planes",
        "LN_{in} statistics"
       ]
      },
      {
       "id": "F2",
       "name": "contractions",
       "impl": "cuBLAS · bmm / CUDA · contract_kernel",
       "code": [
        "# outgoing: X[c,i,j] = Σ_k a[c,i,k] b[c,j,k]",
        "# incoming: X[c,i,j] = Σ_k a[c,k,i] b[c,k,j]",
        "# bidirectional: outgoing on the first H/2",
        "# channels, incoming on the rest; one launch",
        "# for both halves at L <= 512 (contract_kernel)"
       ],
       "reads": [
        "a | b planes"
       ],
       "writes": [
        "X [H, L, L]"
       ]
      },
      {
       "id": "F3",
       "name": "output LN + proj + gate",
       "impl": "CUDA · k3_kernel",
       "code": [
        "o = layer_norm(X, (H,), γ_o, β_o) @ W_o^T",
        "g = sigmoid(layer_norm(x, (128,), γ, β) @ W_g^T)",
        "y = x + g * o"
       ],
       "reads": [
        "X",
        "x",
        "W_o', W_g', s, b",
        "LN_{in} statistics"
       ],
       "writes": [
        "y"
       ]
      }
     ],
