     "kernels": [
      {
       "id": "P1",
       "name": "weight pack (training)",
       "impl": "CUDA · pack_kernel",
       "code": [
        "# the forward's folds, and for the backward:",
        "W_{dx} = [W_in ; W_g]   # unscaled rows, K1 order",
        "W_o·γ_o and its row sums, W_g·γ"
       ],
       "reads": [
        "W_l, W_lg, W_r, W_rg",
        "W_g, W_o",
        "γ, β, γ_o, β_o"
       ],
       "writes": [
        "w1, W_{dx}",
        "folded W_o, W_g, row sums"
       ]
      },
      {
       "id": "B1",
       "name": "output-side backward",
       "impl": "CUDA · b1g_kernel (H = 128) / b1_kernel (H = 256)",
       "code": [
        "o = r_o (X W_o'^T) - r_o μ_o s_o + b_o ;  s = sigmoid(x_n W_g^T)",
        "d_upd = dy * ds ;  d_o = d_upd * s ;  d_g = d_upd * o * s (1 - s)",
        "A_o = d_o r_o ;  dX = LN_out backward of (A_o W_o')",
        "G += A_o^T X^T   # on chip at H = 128"
       ],
       "reads": [
        "X, x_n",
        "dy, ds",
        "W_o', W_g",
        "LN statistics"
       ],
       "writes": [
        "dX [H, L, L]",
        "d_g",
        "G, v_o, S_o (fp32 partials)",
        "A_o (H = 256)"
       ]
      },
      {
       "id": "B2",
       "name": "contraction backward",
       "impl": "cuBLAS · bmm",
       "code": [
        "# outgoing: dA = dX b ;  db = dX^T a",
        "# incoming: dA = b dX^T ;  db = a dX"
       ],
       "reads": [
        "dX",
        "a | b planes"
       ],
       "writes": [
        "dA | db planes"
       ]
      },
      {
       "id": "W",
       "name": "weight gradients (side stream, under B2)",
       "impl": "cuBLAS · GEMM + PyTorch",
       "code": [
        "dW_g = d_g^T x_n",
        "dW_o = (G - v_o 1^T) γ_o + S_o β_o^T",
        "dγ_o = Σ W_o (G - v_o) ;  dβ_o = Σ W_o S_o"
       ],
       "reads": [
        "d_g, x_n",
        "G, v_o, S_o",
        "W_o, γ_o, β_o"
       ],
       "writes": [
        "dW_g, dW_o",
        "dγ_o, dβ_o"
       ]
      },
      {
       "id": "B3",
       "name": "input-side backward",
       "impl": "CUDA · b7j_kernel",
       "code": [
        "# sources (one 64-row weight block each):",
        "(g, p) = x_n W_in^T ;  dp = dA s m ;  dg = dA p s (1 - s) m",
        "dW_in += x_n^T [dg | dp]   # registers, whole launch",
        "# dgp tile -> L2 ring -> consumers:",
        "dx_n = [dgp | d_g] [W_in ; W_g]",
        "dz = LN_in backward(dx_n) + dy ;  dγ, dβ partials"
       ],
       "reads": [
        "dA | db planes",
        "x_n, x, dy, d_g",
        "W_{dx}, w1",
        "LN statistics, mask [L]"
       ],
       "writes": [
        "dz",
        "dW_in partials (fp32)",
        "dγ, dβ partials (fp32)"
       ]
      },
      {
       "id": "F",
       "name": "finalize",
       "impl": "CUDA · finalize_kernel",
       "code": [
        "dW_{l,lg,r,rg} = Σ_groups dW_in[row]   # fixed order, K1 row order undone",
        "dγ, dβ = Σ_partials",
        "# written in each parameter's strides and dtype"
       ],
       "reads": [
        "dW_in partials",
        "dγ, dβ partials"
       ],
       "writes": [
        "dW_l, dW_lg, dW_r, dW_rg",
        "dγ, dβ"
       ]
      }
