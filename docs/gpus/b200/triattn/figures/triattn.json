{
 "figures": {
  "inference": {
   "title": "B200 · TriangleAttention (starting node) · inference · D128, 4 heads × 32, bf16, every L = 128k",
   "panels": [
    {
     "label": "forward (nothing saved)",
     "kernels": [
      {
       "id": "P1",
       "name": "parameter pack",
       "impl": "CUDA · tri_pack_params",
       "code": [
        "w_4 = torch.cat((W_q, W_k, W_v, W_g)).bfloat16()",
        "w_o = W_o.bfloat16()",
        "prm = torch.cat((γ, β, W_b)).float()"
       ],
       "reads": [
        "W_q, W_k, W_v, W_g, W_o",
        "γ, β, W_b"
       ],
       "writes": [
        "w_4, w_o, prm"
       ]
      },
      {
       "id": "F1",
       "name": "LN + q|k|v|g + bias",
       "impl": "CUDA · tri_front",
       "code": [
        "x_n = F.layer_norm(x, (D,), γ, β)",
        "q, k, v, g = (x_n @ W.T for W in w_4)",
        "b = (x_n @ W_b.T).permute(0, 3, 1, 2)",
        "b = b.masked_fill(~mask[:, None, None], -inf)"
       ],
       "reads": [
        "x",
        "w_4, prm",
        "mask"
       ],
       "writes": [
        "q, k, v, g",
        "b"
       ]
      },
      {
       "id": "F2",
       "name": "attention",
       "impl": "CUDA · triattn_fwd",
       "code": [
        "s = q[h] @ k[h].T / sqrt(32) + b[h]",
        "o[h] = torch.softmax(s, -1) @ v[h]",
        "# per pair row i, head h"
       ],
       "reads": [
        "q, k, v",
        "b"
       ],
       "writes": [
        "o"
       ]
      },
      {
       "id": "F3",
       "name": "gate + out proj + residual",
       "impl": "CUDA · tri_tail",
       "code": [
        "u = torch.sigmoid(g) * o",
        "y = x + (u @ W_o.T)"
       ],
       "reads": [
        "g, o",
        "x",
        "w_o"
       ],
       "writes": [
        "y"
       ]
      }
     ],
     "hbm_title": "HBM (sizes at L = 768)",
     "hbm": [
