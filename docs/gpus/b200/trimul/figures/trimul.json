       "id": "B1",
       "name": "gate backward",
       "impl": "CUDA · wide_gate_bwd",
       "code": [
        "dp = dy * ds * sigmoid(g); dg = dp * o * (1 - sigmoid(g))",
        "dpr = dp * σ_o; S1 = dp·s_p; S2 = dp·(o - e_p)"
       ],
       "reads": [
        "dy",
        "o, g",
        "ds",
        "s, e",
        "μ_o, σ_o"
