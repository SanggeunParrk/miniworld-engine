     "label": "forward (nothing saved)",
     "kernels": [
      {
       "id": "F0",
       "name": "input LN stats",
       "impl": "CUDA · k1w_stats",
       "code": [
        "μ, σ = x.mean(-1), x.var(-1).add(ε).rsqrt()"
       ],
       "reads": [
        "x"
       ],
       "writes": [
        "μ, σ"
       ]
      },
      {
       "id": "F1",
       "name": "input LN + gated proj",
       "impl": "CUDA · k1w",
       "code": [
        "x_n = F.layer_norm(x, (D,), γ, β)",
        "m = mask[:, None] & mask[None, :]",
        "a = sigmoid(x_n @ W_lg.T) * (x_n @ W_l.T) * m",
        "b = sigmoid(x_n @ W_rg.T) * (x_n @ W_r.T) * m",
        "# channel-major planes [P, L, L]"
       ],
       "reads": [
        "x",
        "μ, σ",
        "W_l, W_lg, W_r, W_rg",
        "mask [L]",
        "γ, β"
       ],
       "writes": [
        "a, b (planes)"
       ]
      },
      {
       "id": "F2",
       "name": "contractions",
       "impl": "cuBLAS · bmm",
       "code": [
        "# one direction (outgoing):",
        "t = einsum(\"bikd,bjkd->bijd\", a, b)",
        "# bidirectional: outgoing on the first",
        "# half of the planes, incoming on the",
        "# second, t = cat(t_out, t_in)"
       ],
       "reads": [
        "a, b"
       ],
       "writes": [
        "t"
       ]
      },
      {
       "id": "F3",
       "name": "output LN stats",
       "impl": "CUDA · wide_ln_stats",
       "code": [
        "μ_o, σ_o over the H channels of t"
       ],
       "reads": [
        "t"
       ],
       "writes": [
        "μ_o, σ_o"
       ]
      },
      {
       "id": "F4",
       "name": "LN-affine fold",
       "impl": "CUDA · wide_fold_prep",
       "code": [
        "W_p' = bf16(W_p * γ_o); s_p = W_p'.sum(1); e_p = W_p @ β_o",
        "W_g' = bf16(W_g * γ); s_g = W_g'.sum(1); e_g = W_g @ β"
       ],
       "reads": [
        "W_p, W_g, γ_o, β_o, γ, β"
       ],
       "writes": [
        "W_p', W_g', s, e"
       ]
      },
      {
       "id": "F5",
       "name": "output GEMMs + gate",
       "impl": "CUDA · k3w",
       "code": [
        "o = σ_o * (t.T @ W_p'.T - μ_o * s_p) + e_p",
        "g = σ * (x @ W_g'.T - μ * s_g) + e_g",
        "y = x + ds * (sigmoid(g) * o)"
       ],
       "reads": [
        "t (as stored)",
        "x",
        "W_p', W_g', s, e",
        "μ, σ, μ_o, σ_o",
        "ds (dropout only)"
       ],
       "writes": [
        "y"
       ]
      }
