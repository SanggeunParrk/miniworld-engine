        "    (a, b, x_n), (x, w_1, γ, β),",
        "    (da, db, dx_ng))",
        "dx = dx + dy"
       ],
       "reads": [
        "da, db",
        "dx_ng",
        "dy",
        "x, x_n",
        "w_1, W_g, mask"
       ],
       "writes": [
        "dx",
        "dw_1",
        "dγ, dβ"
       ]
      },
