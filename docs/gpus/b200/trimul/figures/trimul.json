{
 "figures": {
  "inference_small": {
   "title": "B200 · TriMul · inference · D64 / D128, bf16, every L = 16k (one direction: P = 2D, H = D; bidirectional: P = 4D, H = 2D)",
   "panels": [
    {
     "label": "forward (nothing saved)",
     "kernels": [
      {
       "id": "P1",
       "name": "weight prep",
       "impl": "CUDA · k1w_prep",
       "code": [
        "w_p' = W_p[:, perm]   # k3g's TMEM K order",
        "W_* = W_*.contiguous()  # only if strided"
       ],
       "reads": [
        "W_l, W_lg, W_r, W_rg, W_p"
       ],
       "writes": [
        "w_p' (, W_* copies)"
       ]
      },
      {
       "id": "F1",
       "name": "input LN + gated proj",
       "impl": "CUDA · k1w",
       "code": [
        "x_n = F.layer_norm(x, (D,), γ, β)",
        "m = mask[:, None] & mask[None, :]",
        "a = sigmoid(x_n @ W_lg.T) * (x_n @ W_l.T) * m",
        "b = sigmoid(x_n @ W_rg.T) * (x_n @ W_r.T) * m",
        "# channel-major planes [P, L, L]"
       ],
       "reads": [
        "x",
        "W_l, W_lg, W_r, W_rg",
        "mask [L]",
        "γ, β"
       ],
       "writes": [
        "a, b (planes)"
       ]
      },
      {
       "id": "F2",
       "name": "contractions",
       "impl": "cuBLAS · bmm",
       "code": [
        "# one direction (outgoing):",
        "t = einsum(\"bikd,bjkd->bijd\", a, b)",
        "# bidirectional: outgoing on the first",
        "# half of the planes, incoming on the",
        "# second, t = cat(t_out, t_in)"
       ],
       "reads": [
        "a, b"
       ],
       "writes": [
        "t"
       ]
      },
      {
       "id": "F3",
       "name": "output LN + proj + gate",
       "impl": "CUDA · k3g",
       "code": [
        "o = F.layer_norm(t, (H,), γ_o, β_o) @ W_p.T",
        "x_n = F.layer_norm(x, (D,), γ, β)",
        "g = torch.sigmoid(x_n @ W_g.T)",
        "y = x + ds * (g * o)"
       ],
       "reads": [
        "t",
        "x",
        "w_p', W_g, γ, β, γ_o, β_o",
        "ds (dropout only)"
       ],
       "writes": [
        "y"
       ]
      }
     ],
     "hbm_title": "HBM (sizes at L = 768, D128 bidirectional)",
     "hbm": [
      {
       "name": "x, y",
       "shape": "[L,L,D] bf16",
