       "id": "B4",
       "name": "weight-grad unpack",
       "impl": "PyTorch",
       "code": [
        "dW_l, dW_lg, dW_r, dW_rg =",
        "    unpack(dw_1)   # inverse of P2"
       ],
       "reads": [
        "dw_1"
       ],
       "writes": [
        "dW_l, dW_lg, dW_r, dW_rg"
       ]
      }
