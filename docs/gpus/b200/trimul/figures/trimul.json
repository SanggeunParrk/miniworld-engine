      {
       "id": "B5",
       "name": "front backward",
       "impl": "CUDA · k1wb",
       "code": [
        "recompute gate / proj pre-activations",
        "dpre = (d gate, d proj) from da, db",
        "  # token-major, w_1 row order"
       ],
       "reads": [
        "x, μ, σ, γ, β",
        "W_l, W_lg, W_r, W_rg",
        "mask",
        "da, db"
       ],
       "writes": [
        "dpre"
       ]
      },
      {
       "id": "B6",
       "name": "input LN apply",
       "impl": "CUDA · wide_ln_apply",
       "code": [
        "x_n = (x - μ) σ γ + β"
       ],
       "reads": [
        "x, μ, σ, γ, β"
       ],
       "writes": [
        "x_n"
       ]
      },
      {
       "id": "B7",
       "name": "input-projection grads",
       "impl": "cuBLAS · mm",
