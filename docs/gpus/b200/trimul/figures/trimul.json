        "t",
        "μ_o, σ_o, S1, S2, γ_o"
       ],
       "writes": [
        "dt",
        "dγ_o, dβ_o"
       ]
      },
      {
       "id": "B4",
       "name": "contraction grads",
       "impl": "cuBLAS · bmm",
       "code": [
