       "name": "output-projection grads",
       "impl": "cuBLAS · mm",
       "code": [
        "do^T = W_p.T @ dpr.T   # channel-major",
        "dW_p = γ_o (dpr.T @ t.T - r1) + β_o r0"
       ],
       "reads": [
        "dpr",
        "t"
       ],
       "writes": [
        "do^T",
        "dW_p"
       ]
