       "name": "weight-grad unpack",
       "impl": "PyTorch",
       "code": [
        "dW_lg, dW_l, dW_rg, dW_r =",
        "    unpack(dw_1)   # inverse of P1"
       ],
       "reads": [
        "dw_1"
       ],
       "writes": [
        "dW_l, dW_lg, dW_r, dW_rg"
       ]
      }
