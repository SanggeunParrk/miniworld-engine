       ]
      },
      {
       "id": "B2",
       "name": "contraction grads ×4",
       "impl": "cuBLAS · bmm",
       "code": [
        "dl, dr = torch.autograd.grad(",
        "    t, (l, r), dt)"
       ],
       "reads": [
        "dt",
        "l_out, l_in",
        "r_out, r_in"
       ],
       "writes": [
        "dl, dr"
       ]
      },
      {
       "id": "B3",
       "name": "input-side backward",
       "impl": "CUDA · b200_bidir B7r",
       "code": [
        "(dx, dw_1, dγ, dβ) = torch.autograd.grad(",
        "    (l, r, x_n), (x, w_1, γ, β),",
        "    (dl, dr, dx_ng))",
        "dx = dx + dy"
       ],
       "reads": [
        "dl, dr",
        "dx_ng",
        "dy",
        "x, x_n",
        "w_1, W_g, mask"
       ],
       "writes": [
        "dx",
        "dw_1",
        "dγ, dβ"
       ]
      },
      {
