    {
     "label": "backward",
     "kernels": [
      {
       "id": "B1",
       "name": "output-side backward",
       "impl": "CUDA · b200_bidir B1r",
       "code": [
        "(dt, dx_ng, dW_p, dW_g,",
        " dγ_o, dβ_o) = torch.autograd.grad(",
        "    y, (t, x_n, W_p, W_g,",
