    "training_wide": {
      "title": "H100 · TriMul bidirectional · training · D256 / D384 / D512, bf16, L384 / L768",
      "panels": [
        {"label": "forward (saves l_*, r_*, t, x_n, o, proj, gate, LN_out stats)",
         "kernels": [
          {"id": "P1", "name": "weight pack", "impl": "Triton · _pack",
           "code": ["g = torch.cat((W_lg, W_rg))", "v = torch.cat((W_l, W_r))", "w_1 = torch.stack((g, v), 1)"],
           "reads": ["W_l, W_lg, W_r, W_rg"], "writes": ["w_1"]},
          {"id": "F1", "name": "input LN + gated proj", "impl": "CUDA · mw_*_front",
           "code": ["x_n = F.layer_norm(x, (D,), γ, β)", "pre = x_n @ w_1.T", "l = torch.sigmoid(x_n @ W_lg.T)", "l = l * (x_n @ W_l.T) * m", "r = torch.sigmoid(x_n @ W_rg.T)", "r = r * (x_n @ W_r.T) * m"],
           "reads": ["x (D512: x_n)", "w_1", "mask"], "writes": ["l_*, r_*", "x_n", "pre (D384/512)"]},
          {"id": "F2", "name": "contractions ×2", "impl": "cuBLAS · bmm / cuBLASLt",
           "code": ["t_out = torch.einsum(", "  \"bikd,bjkd->bijd\", l_out, r_out)", "t_in = torch.einsum(", "  \"bkid,bkjd->bijd\", l_in, r_in)", "t = torch.cat((t_out, t_in), -1)"],
           "reads": ["l_*, r_*"], "writes": ["t"]},
          {"id": "F3", "name": "output LN", "impl": "CUDA · mw_wide_*_norm",
           "code": ["o = F.layer_norm(t, (2h,), γ_o, β_o)"],
           "reads": ["t", "γ_o, β_o"], "writes": ["o", "μ_o, σ_o"]},
          {"id": "F4", "name": "proj + gate GEMMs", "impl": "cuBLASLt",
           "code": ["proj = o @ W_p.T", "gate = x_n @ W_g.T"],
           "reads": ["o", "x_n", "W_p, W_g"], "writes": ["proj, gate"]},
          {"id": "F5", "name": "gate + residual", "impl": "CUDA · mw_wide_dense_output_epi",
           "code": ["y = x + ds * torch.sigmoid(gate)", "      * proj"],
           "reads": ["proj, gate", "x", "ds"], "writes": ["y"]}
         ],
         "hbm_title": "HBM, forward",
         "hbm": [
          {"name": "x, y", "shape": "[L,L,D] bf16"},
          {"name": "x_n  (saved)", "shape": "[L,L,D] bf16"},
          {"name": "pre  (saved, D384/512)", "shape": "[8D,L·L] bf16"},
          {"name": "l_*, r_*  (saved)", "shape": "4 × [D,L,L] bf16"},
          {"name": "t  (saved)", "shape": "[2D,L,L] bf16"},
          {"name": "o  (saved)", "shape": "[L·L,2D] bf16"},
          {"name": "proj, gate  (saved)", "shape": "2 × [L·L,D] bf16"},
          {"name": "μ_o, σ_o  (saved)", "shape": "2 × [L·L] fp32"},
          {"name": "mask, ds, W_*, w_1", "shape": "bf16 / fp32"}
         ]},
        {"label": "backward (D512 first repairs o / proj rows: CUDA mw_wide_*delta*)",
         "kernels": [
          {"id": "B1", "name": "gate backward", "impl": "CUDA · mw_*_gate",
           "code": ["dproj, dgate = torch.autograd.grad(", "    y, (proj, gate), dy)"],
           "reads": ["dy", "proj, gate", "ds"], "writes": ["dproj", "dgate"]},
          {"id": "B2", "name": "dn GEMM", "impl": "cuBLASLt",
           "code": ["do = dproj @ W_p"],
           "reads": ["dproj", "W_p"], "writes": ["do"]},
          {"id": "B3", "name": "output-LN backward", "impl": "CUDA · mw_*_output_ln",
           "code": ["dt, dγ_o, dβ_o = torch.autograd.grad(", "    o, (t, γ_o, β_o), do)"],
           "reads": ["do", "t", "μ_o, σ_o", "γ_o"], "writes": ["dt", "dγ_o, dβ_o"]},
          {"id": "B4", "name": "contraction grads", "impl": "CUDA / cuBLASLt (by shape)",
           "code": ["dl, dr = torch.autograd.grad(", "    t, (l, r), dt)", "dpre = torch.autograd.grad(", "    (l, r), pre, (dl, dr))"],
           "reads": ["dt", "l_*, r_*", "pre / x_n, w_1", "mask"], "writes": ["dpre", "partials"]},
          {"id": "B5", "name": "weight GEMMs", "impl": "cuBLAS / cuBLASLt",
           "code": ["dW_p = dproj.T @ o", "dW_g = dgate.T @ x_n", "dW_1 = dpre @ x_n"],
           "reads": ["dproj, dgate, dpre", "o, x_n"], "writes": ["dW_p, dW_g", "partials"]},
          {"id": "B6", "name": "dx_n GEMM", "impl": "cuBLASLt",
           "code": ["W_c = torch.cat((W_g, W_l, W_lg,", "                 W_r, W_rg))", "dx_n = torch.cat((dgate, dpre),", "    1) @ W_c"],
           "reads": ["dgate, dpre", "W_*"], "writes": ["dx_n"]},
          {"id": "B7", "name": "input-LN backward + reduce", "impl": "CUDA · mw_*_input_*",
           "code": ["dx, dγ, dβ = torch.autograd.grad(", "    x_n, (x, γ, β), dx_n)", "dx = dx + dy", "dW = partials.sum(0)"],
           "reads": ["dx_n", "x", "dy", "γ", "partials"], "writes": ["dx", "dW_*, dγ, dβ"]}
         ],
         "hbm_title": "HBM, backward",
         "hbm": [
