        {"label": "backward",
         "kernels": [
          {"id": "B1", "name": "output-side backward", "impl": "CUDA · d64_b1w",
           "code": ["(dt, dx_ng, dW_p, dW_g,", " dγ_o, dβ_o) = torch.autograd.grad(", "    y, (t, x_n, W_p, W_g,", "        γ_o, β_o), dy)"],
           "reads": ["dy", "t", "x", "stats", "W_p, W_g, γ_o, β_o"], "writes": ["dt", "dx_ng", "partials_1"]},
          {"id": "B2", "name": "contraction grads ×4", "impl": "cuBLAS · bmm",
           "code": ["dl, dr = torch.autograd.grad(", "    t, (l, r), dt)"],
           "reads": ["dt", "l_out, l_in", "r_out, r_in"], "writes": ["dl, dr"]},
          {"id": "B3", "name": "input-side backward", "impl": "CUDA · d64_b2w",
           "code": ["(dx, dW_l, dW_lg, dW_r, dW_rg,", " dγ, dβ) = torch.autograd.grad(", "    (l, r, x_n), (x, W_l, W_lg,", "    W_r, W_rg, γ, β),", "    (dl, dr, dx_ng))", "dx = dx + dy"],
           "reads": ["dl, dr", "dx_ng", "dy", "x", "stats", "w_1, mask"], "writes": ["dx", "partials_2"]},
          {"id": "B4", "name": "weight-grad reduce", "impl": "CUDA · d64_finw",
           "code": ["dW = partials.sum(0)"],
           "reads": ["partials_1, partials_2"], "writes": ["dW_*, dγ, dβ, dγ_o, dβ_o"]}
