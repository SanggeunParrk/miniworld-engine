           "reads": ["W_l, W_lg, W_r, W_rg"], "writes": ["w_1"]},
          {"id": "F1", "name": "input LN + gated proj", "impl": "CUDA · h100_inference K1",
           "code": ["x_n = F.layer_norm(x, (D,), γ, β)", "l = torch.sigmoid(x_n @ W_lg.T)", "l = l * (x_n @ W_l.T) * m", "r = torch.sigmoid(x_n @ W_rg.T)", "r = r * (x_n @ W_r.T) * m", "l_out, l_in = l.chunk(2, -1)", "r_out, r_in = r.chunk(2, -1)"],
           "reads": ["x", "w_1", "mask", "γ, β"], "writes": ["l_out, l_in", "r_out, r_in"]},
          {"id": "F2", "name": "contractions ×2", "impl": "cuBLAS · bmm",
           "code": ["t_out = torch.einsum(", "  \"bikd,bjkd->bijd\", l_out, r_out)", "t_in = torch.einsum(", "  \"bkid,bkjd->bijd\", l_in, r_in)", "t = torch.cat((t_out, t_in), -1)"],
           "reads": ["l_out, l_in", "r_out, r_in"], "writes": ["t"]},
          {"id": "F3", "name": "output LN + proj + gate", "impl": "CUDA · h100_inference K3",
           "code": ["o = F.layer_norm(t, (2h,), γ_o, β_o)", "o = o @ W_p.T", "x_n = F.layer_norm(x, (D,), γ, β)", "g = torch.sigmoid(x_n @ W_g.T)", "y = x + g * o"],
