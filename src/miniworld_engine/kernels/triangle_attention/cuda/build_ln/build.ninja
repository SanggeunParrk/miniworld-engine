ninja_required_version = 1.3
cxx = c++
nvcc = /home/psk6950/miniworld-engine/.pixi/envs/default/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=triattn_ln_warp_packed -DTORCH_API_INCLUDE_EXTENSION_H -I/home/psk6950/miniworld-engine-scratch/wt-integration/src/miniworld_engine/kernels/triangle_attention/cuda -I/home/psk6950/MiniWorld/runs/anthropic_adoption_20260919/cutlass-4.2/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/lib/python3.12/site-packages/torch/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/include/python3.12 -fPIC -std=c++20 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=triattn_ln_warp_packed -DTORCH_API_INCLUDE_EXTENSION_H -I/home/psk6950/miniworld-engine-scratch/wt-integration/src/miniworld_engine/kernels/triangle_attention/cuda -I/home/psk6950/MiniWorld/runs/anthropic_adoption_20260919/cutlass-4.2/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/lib/python3.12/site-packages/torch/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/include -isystem /home/psk6950/miniworld-engine/.pixi/envs/default/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90a,code=sm_90a --compiler-options '-fPIC' -O3 -std=c++17 --expt-relaxed-constexpr --expt-extended-lambda -lineinfo -Xptxas=-v
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/psk6950/miniworld-engine/.pixi/envs/default/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/psk6950/miniworld-engine/.pixi/envs/default/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build ln_residual.cuda.o: cuda_compile /home/psk6950/miniworld-engine-scratch/wt-integration/src/miniworld_engine/kernels/triangle_attention/cuda/ln_residual.cu





build triattn_ln_warp_packed.so: link ln_residual.cuda.o

default triattn_ln_warp_packed.so
